---
import {
    Home,
    Lightbulb,
    Briefcase,
    User,
    Github,
    Twitter,
} from "lucide-react";
---

<div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50">
    <nav
        class="flex items-center gap-2 p-2 bg-background/60 backdrop-blur-xl border border-border/40 rounded-full shadow-2xl ring-1 ring-white/10"
    >
        <a
            href="/"
            class="p-3 rounded-full hover:bg-white/10 transition-colors group relative"
        >
            <Home
                className="w-5 h-5 text-foreground/80 group-hover:text-foreground"
            />
            <span
                class="absolute -top-10 left-1/2 -translate-x-1/2 px-2 py-1 bg-background border border-border text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity"
                >Home</span
            >
        </a>
        <a
            href="/projects"
            class="p-3 rounded-full hover:bg-white/10 transition-colors group relative"
        >
            <Briefcase
                className="w-5 h-5 text-foreground/80 group-hover:text-foreground"
            />
            <span
                class="absolute -top-10 left-1/2 -translate-x-1/2 px-2 py-1 bg-background border border-border text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity"
                >Projects</span
            >
        </a>
        <a
            href="/thoughts"
            class="p-3 rounded-full hover:bg-white/10 transition-colors group relative"
        >
            <Lightbulb
                className="w-5 h-5 text-foreground/80 group-hover:text-foreground"
            />
            <span
                class="absolute -top-10 left-1/2 -translate-x-1/2 px-2 py-1 bg-background border border-border text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity"
                >Thoughts</span
            >
        </a>
        <div class="w-px h-6 bg-border mx-1"></div>
        <a
            href="https://github.com/hungp"
            target="_blank"
            class="p-3 rounded-full hover:bg-white/10 transition-colors group relative"
        >
            <Github
                className="w-5 h-5 text-foreground/80 group-hover:text-foreground"
            />
        </a>
    </nav>
</div>

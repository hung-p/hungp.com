---
import { siteConfig } from "../site.config";
import { Github, Linkedin, Twitter, Mail, Copy, ArrowUp } from "lucide-react";

const year = new Date().getFullYear();

const buildingLinks = [
	{ label: "AIGallery", href: "https://aigallery.app" },
	{ label: "VeganForReal", href: "https://veganforreal.com" },
	{ label: "VocalLoom", href: "https://vocalloom.com" },
	{ label: "Opmun", href: "https://opmun.com" },
];

const navLinks = [
	{ label: "Home", href: "/" },
	{ label: "Projects", href: "/projects" },
	{ label: "About", href: "/about" },
	{ label: "Research", href: "/research" },
];
---

<footer class="relative mt-28">
	<!-- accent glow + fading hairline -->
	<div
		class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-64 bg-[radial-gradient(ellipse_55%_100%_at_50%_0%,hsl(var(--brand)/0.08),transparent_70%)]"
		aria-hidden="true"
	>
	</div>
	<div
		class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-border to-transparent"
	>
	</div>

	<div class="mx-auto w-full max-w-[1120px] px-4 pb-28 pt-16 md:px-8">
		<div class="grid gap-12 md:grid-cols-[1.5fr_1fr_1fr]">
			<!-- Sign-off -->
			<div class="max-w-sm">
				<a href="/" class="group inline-flex items-center gap-3">
					<span
						class="grid h-9 w-9 place-items-center rounded-[11px] bg-foreground font-mono text-sm font-semibold text-background transition-transform duration-300 group-hover:-rotate-6"
						>hp</span
					>
					<span class="text-lg font-semibold">Hung Pham</span>
				</a>

				<p class="mt-5 text-2xl font-semibold tracking-tight md:text-[27px]">
					Let's build something <span class="text-brand-2">useful</span>.
				</p>
				<p class="mt-3 text-sm leading-relaxed text-muted-foreground">
					Always glad to meet builders and curious people. The inbox is
					open.
				</p>

				<!-- Copy-email pill -->
				<button
					type="button"
					data-copy={siteConfig.email}
					aria-label={`Copy email ${siteConfig.email}`}
					class="group/mail mt-5 inline-flex items-center gap-2.5 rounded-full border border-border bg-surface px-4 py-2.5 font-mono text-sm text-foreground transition-colors hover:border-foreground/15 data-[copied]:border-live/40 data-[copied]:text-live"
				>
					<Mail
						className="h-4 w-4 text-subtle transition-colors group-hover/mail:text-brand-2"
					/>
					<span data-copy-label>{siteConfig.email}</span>
					<Copy className="h-3.5 w-3.5 text-subtle" />
				</button>

				<!-- Socials -->
				<div class="mt-5 flex items-center gap-2.5">
					<a
						href={siteConfig.github}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GitHub"
						class="social-btn"
					>
						<Github className="h-[18px] w-[18px]" />
					</a>
					<a
						href={siteConfig.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn"
						class="social-btn"
					>
						<Linkedin className="h-[18px] w-[18px]" />
					</a>
					<a
						href={siteConfig.twitter}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Twitter / X"
						class="social-btn"
					>
						<Twitter className="h-[18px] w-[18px]" />
					</a>
				</div>
			</div>

			<!-- Navigate -->
			<div>
				<h2
					class="mb-4 font-mono text-[11px] uppercase tracking-[0.14em] text-subtle"
				>
					Navigate
				</h2>
				<ul class="space-y-2.5 text-sm">
					{
						navLinks.map((l) => (
							<li>
								<a class="footer-link" href={l.href}>
									{l.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Building -->
			<div>
				<h2
					class="mb-4 font-mono text-[11px] uppercase tracking-[0.14em] text-subtle"
				>
					Building
				</h2>
				<ul class="space-y-2.5 text-sm">
					{
						buildingLinks.map((l) => (
							<li>
								<a
									class="footer-link inline-flex items-center gap-1.5"
									href={l.href}
									target="_blank"
									rel="noopener noreferrer"
								>
									{l.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<!-- Bottom bar -->
		<div
			class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6 text-[13px] text-subtle"
		>
			<span>© {year} Hung Pham. All rights reserved.</span>
			<div class="flex items-center gap-5">
				<span class="inline-flex items-center gap-2">
					<span class="relative flex h-1.5 w-1.5">
						<span
							class="absolute inline-flex h-full w-full animate-ping rounded-full bg-live opacity-75"
						></span>
						<span
							class="relative inline-flex h-1.5 w-1.5 rounded-full bg-live"
						></span>
					</span>
					Available for collaboration
				</span>
				<button
					type="button"
					data-scroll-top
					class="inline-flex items-center gap-1.5 transition-colors hover:text-foreground"
				>
					Back to top
					<ArrowUp className="h-3.5 w-3.5" />
				</button>
			</div>
		</div>
	</div>
</footer>

<style>
	.footer-link {
		color: hsl(var(--muted-foreground));
		transition: color 0.2s ease;
	}
	.footer-link:hover {
		color: hsl(var(--brand-2));
	}
	.social-btn {
		display: grid;
		place-items: center;
		height: 2.25rem;
		width: 2.25rem;
		border-radius: 9999px;
		border: 1px solid hsl(var(--border));
		background: hsl(var(--surface));
		color: hsl(var(--muted-foreground));
		transition:
			transform 0.25s ease,
			color 0.25s ease,
			border-color 0.25s ease;
	}
	.social-btn:hover {
		transform: translateY(-2px);
		color: hsl(var(--brand-2));
		border-color: hsl(var(--foreground) / 0.15);
	}
</style>

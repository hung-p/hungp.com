---
import { siteConfig } from "../site.config";
import { Github, Linkedin, Twitter, Mail, Copy, ArrowUp } from "lucide-react";

const year = new Date().getFullYear();

const buildingLinks = [
	{ label: "AIGallery", href: "https://aigallery.app" },
	{ label: "Amudia", href: "https://amudia.com" },
	{ label: "VeganForReal", href: "https://veganforreal.com" },
	{ label: "VocalLoom", href: "https://vocalloom.com" },
	{ label: "StudyRails", href: "https://studyrails.com" },
];

const navLinks = [
	{ label: "Home", href: "/" },
	{ label: "Projects", href: "/projects" },
	{ label: "About", href: "/about" },
	{ label: "Research", href: "/research" },
];
---

<footer class="footer">
	<!-- accent glow + fading hairline -->
	<div class="foot-glow" aria-hidden="true"></div>
	<div
		class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-border to-transparent"
	>
	</div>

	<div class="relative z-10 mx-auto w-full max-w-[1120px] px-4 pt-20 md:px-8">
		<!-- Closing CTA -->
		<div class="max-w-2xl">
			<p class="eyebrow mb-5">Get in touch</p>
			<h2
				class="text-4xl font-semibold leading-[1.04] tracking-tighter md:text-6xl"
			>
				Let's build something <span class="text-brand-2">people use</span>.
			</h2>
			<p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
				Always glad to meet builders and curious people. The inbox is open.
			</p>

			<div class="mt-8 flex flex-wrap items-center gap-3">
				<button
					type="button"
					data-copy={siteConfig.email}
					aria-label={`Copy email ${siteConfig.email}`}
					class="group/mail inline-flex items-center gap-2.5 rounded-full border border-border bg-surface px-5 py-3 font-mono text-sm text-foreground transition-colors hover:border-foreground/15 data-[copied]:border-live/40 data-[copied]:text-live"
				>
					<Mail
						className="h-4 w-4 text-subtle transition-colors group-hover/mail:text-brand-2"
					/>
					<span data-copy-label>{siteConfig.email}</span>
					<Copy className="h-3.5 w-3.5 text-subtle" />
				</button>

				<div class="flex items-center gap-2.5">
					<a
						href={siteConfig.github}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GitHub"
						class="social-btn"
					>
						<Github className="h-[18px] w-[18px]" />
					</a>
					<a
						href={siteConfig.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn"
						class="social-btn"
					>
						<Linkedin className="h-[18px] w-[18px]" />
					</a>
					<a
						href={siteConfig.twitter}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Twitter / X"
						class="social-btn"
					>
						<Twitter className="h-[18px] w-[18px]" />
					</a>
				</div>
			</div>
		</div>

		<!-- Nav + brand -->
		<div
			class="mt-16 flex flex-wrap items-start justify-between gap-10 border-t border-border pt-10"
		>
			<a href="/" class="group inline-flex items-center gap-3">
				<span
					class="grid h-9 w-9 place-items-center rounded-[11px] bg-foreground font-mono text-sm font-semibold text-background transition-transform duration-300 group-hover:-rotate-6"
					>hp</span
				>
				<span class="text-lg font-semibold">Hung Pham</span>
			</a>

			<div class="flex flex-wrap gap-x-16 gap-y-8">
				<div>
					<h2
						class="mb-4 font-mono text-[11px] uppercase tracking-[0.14em] text-subtle"
					>
						Navigate
					</h2>
					<ul class="space-y-2.5 text-sm">
						{
							navLinks.map((l) => (
								<li>
									<a class="footer-link" href={l.href}>
										{l.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
				<div>
					<h2
						class="mb-4 font-mono text-[11px] uppercase tracking-[0.14em] text-subtle"
					>
						Building
					</h2>
					<ul class="space-y-2.5 text-sm">
						{
							buildingLinks.map((l) => (
								<li>
									<a
										class="footer-link"
										href={l.href}
										target="_blank"
										rel="noopener noreferrer"
									>
										{l.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>

		<!-- Bottom bar -->
		<div
			class="mt-12 flex flex-wrap items-center justify-between gap-4 text-[13px] text-subtle"
		>
			<span>© {year} Hung Pham. All rights reserved.</span>
			<div class="flex items-center gap-5">
				<span class="inline-flex items-center gap-2">
					<span class="relative flex h-1.5 w-1.5">
						<span
							class="absolute inline-flex h-full w-full animate-ping rounded-full bg-live opacity-75"
						></span>
						<span
							class="relative inline-flex h-1.5 w-1.5 rounded-full bg-live"
						></span>
					</span>
					Available for collaboration
				</span>
				<button
					type="button"
					data-scroll-top
					class="inline-flex items-center gap-1.5 transition-colors hover:text-foreground"
				>
					Back to top
					<ArrowUp className="h-3.5 w-3.5" />
				</button>
			</div>
		</div>
	</div>

	<!-- Giant sign-off wordmark -->
	<div class="wordmark" aria-hidden="true">hungp.com</div>
</footer>

<style>
	.footer {
		position: relative;
		margin-top: 8rem;
		overflow: hidden;
	}
	.foot-glow {
		position: absolute;
		inset-inline: 0;
		top: 0;
		height: 22rem;
		z-index: 0;
		pointer-events: none;
		background: radial-gradient(
			ellipse 60% 100% at 50% 0%,
			hsl(var(--brand) / 0.1),
			transparent 70%
		);
	}
	.footer-link {
		color: hsl(var(--muted-foreground));
		transition: color 0.2s ease;
	}
	.footer-link:hover {
		color: hsl(var(--brand-2));
	}
	.social-btn {
		display: grid;
		place-items: center;
		height: 2.25rem;
		width: 2.25rem;
		border-radius: 9999px;
		border: 1px solid hsl(var(--border));
		background: hsl(var(--surface));
		color: hsl(var(--muted-foreground));
		transition:
			transform 0.25s ease,
			color 0.25s ease,
			border-color 0.25s ease;
	}
	.social-btn:hover {
		transform: translateY(-2px);
		color: hsl(var(--brand-2));
		border-color: hsl(var(--foreground) / 0.15);
	}

	/* Giant faded sign-off across the bottom */
	.wordmark {
		position: relative;
		z-index: 1;
		margin-top: 3rem;
		margin-bottom: -0.12em;
		text-align: center;
		font-weight: 800;
		font-size: clamp(3.2rem, 17vw, 15rem);
		line-height: 0.82;
		letter-spacing: -0.04em;
		white-space: nowrap;
		color: transparent;
		background: linear-gradient(
			to bottom,
			hsl(var(--foreground) / 0.08),
			hsl(var(--foreground) / 0)
		);
		-webkit-background-clip: text;
		background-clip: text;
		pointer-events: none;
		user-select: none;
	}
	@media (min-width: 1024px) {
		.wordmark {
			padding-bottom: 56px;
		}
	}
</style>

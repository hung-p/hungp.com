---
import { siteConfig } from "../site.config";
import { Github, Linkedin, Twitter, Mail, Copy, ArrowUp } from "lucide-react";

const year = new Date().getFullYear();

const buildingLinks = [
	{ label: "AIGallery", href: "https://aigallery.app" },
	{ label: "Amudia", href: "https://amudia.com" },
	{ label: "VeganForReal", href: "https://veganforreal.com" },
	{ label: "VocalLoom", href: "https://vocalloom.com" },
	{ label: "StudyRails", href: "https://studyrails.com" },
];

const navLinks = [
	{ label: "Home", href: "/" },
	{ label: "Projects", href: "/projects" },
	{ label: "About", href: "/about" },
	{ label: "Research", href: "/research" },
];
---

<footer class="footer">
	<!-- accent glow + fading hairline -->
	<div class="foot-glow" aria-hidden="true"></div>
	<div
		class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-border to-transparent"
	>
	</div>

	<div class="relative z-10 mx-auto w-full max-w-[1120px] px-4 pt-20 md:px-8">
		<div
			class="flex flex-col gap-12 lg:flex-row lg:items-start lg:justify-between lg:gap-16"
		>
			<!-- Get in touch -->
			<div class="reveal max-w-md">
				<p class="eyebrow mb-5">Get in touch</p>
				<h2
					class="text-4xl font-semibold leading-[1.04] tracking-tighter md:text-5xl"
				>
					Let's build something <span class="text-brand-2">people use</span>.
				</h2>
				<p class="mt-5 text-lg leading-relaxed text-muted-foreground">
					Always glad to meet builders and curious people. The inbox is open.
				</p>

				<div class="mt-8 flex flex-wrap items-center gap-3">
					<button
						type="button"
						data-copy={siteConfig.email}
						aria-label={`Copy email ${siteConfig.email}`}
						class="group/mail inline-flex items-center gap-2.5 rounded-full border border-border bg-surface px-5 py-3 font-mono text-sm text-foreground transition-all hover:-translate-y-0.5 hover:border-foreground/15 hover:shadow-lg hover:shadow-brand/10 data-[copied]:border-live/40 data-[copied]:text-live"
					>
						<Mail
							className="h-4 w-4 text-subtle transition-colors group-hover/mail:text-brand-2"
						/>
						<span data-copy-label>{siteConfig.email}</span>
						<Copy className="h-3.5 w-3.5 text-subtle" />
					</button>

					<div class="flex items-center gap-2.5">
						<a
							href={siteConfig.github}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="GitHub"
							class="social-btn"
						>
							<Github className="h-[18px] w-[18px]" />
						</a>
						<a
							href={siteConfig.linkedin}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="LinkedIn"
							class="social-btn"
						>
							<Linkedin className="h-[18px] w-[18px]" />
						</a>
						<a
							href={siteConfig.twitter}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Twitter / X"
							class="social-btn"
						>
							<Twitter className="h-[18px] w-[18px]" />
						</a>
					</div>
				</div>

				<!-- Status + copyright -->
				<div class="mt-8 flex flex-col gap-2 text-[13px] text-subtle">
					<span class="inline-flex items-center gap-2">
						<span class="relative flex h-1.5 w-1.5">
							<span
								class="absolute inline-flex h-full w-full animate-ping rounded-full bg-live opacity-75"
							></span>
							<span
								class="relative inline-flex h-1.5 w-1.5 rounded-full bg-live"
							></span>
						</span>
						Available for collaboration
					</span>
					<span>© {year} Hung Pham. All rights reserved.</span>
				</div>
			</div>

			<!-- Navigate + Building -->
			<div class="reveal flex gap-14 sm:gap-20">
				<div>
					<h3
						class="mb-4 font-mono text-[11px] uppercase tracking-[0.14em] text-subtle"
					>
						Navigate
					</h3>
					<ul class="space-y-2.5 text-sm">
						{
							navLinks.map((l) => (
								<li>
									<a class="footer-link" href={l.href}>
										{l.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
				<div>
					<h3
						class="mb-4 font-mono text-[11px] uppercase tracking-[0.14em] text-subtle"
					>
						Building
					</h3>
					<ul class="space-y-2.5 text-sm">
						{
							buildingLinks.map((l) => (
								<li>
									<a
										class="footer-link"
										href={l.href}
										target="_blank"
										rel="noopener noreferrer"
									>
										{l.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>

		<!-- Back to top (its own row, lower down) -->
		<div class="reveal mt-16 flex justify-center">
			<button type="button" data-scroll-top class="back-top group" aria-label="Back to top">
				<ArrowUp className="h-4 w-4" />
				Back to top
			</button>
		</div>
	</div>

	<!-- Giant sign-off wordmark -->
	<div class="wordmark reveal" aria-hidden="true">hungp.com</div>
</footer>

<style>
	.footer {
		position: relative;
		margin-top: 8rem;
		overflow: hidden;
	}
	.foot-glow {
		position: absolute;
		inset-inline: 0;
		top: 0;
		height: 22rem;
		z-index: 0;
		pointer-events: none;
		background: radial-gradient(
			ellipse 60% 100% at 50% 0%,
			hsl(var(--brand) / 0.1),
			transparent 70%
		);
	}

	/* Nav links — underline draws in from the left on hover */
	.footer-link {
		position: relative;
		display: inline-block;
		color: hsl(var(--muted-foreground));
		transition: color 0.22s ease;
	}
	.footer-link::after {
		content: "";
		position: absolute;
		left: 0;
		bottom: -2px;
		height: 1px;
		width: 100%;
		transform: scaleX(0);
		transform-origin: left;
		background: hsl(var(--brand-2));
		transition: transform 0.28s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.footer-link:hover {
		color: hsl(var(--brand-2));
	}
	.footer-link:hover::after {
		transform: scaleX(1);
	}

	/* Social buttons — lift + accent glow */
	.social-btn {
		display: grid;
		place-items: center;
		height: 2.25rem;
		width: 2.25rem;
		border-radius: 9999px;
		border: 1px solid hsl(var(--border));
		background: hsl(var(--surface));
		color: hsl(var(--muted-foreground));
		transition:
			transform 0.25s ease,
			color 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}
	.social-btn:hover {
		transform: translateY(-3px);
		color: hsl(var(--brand-2));
		border-color: hsl(var(--foreground) / 0.15);
		box-shadow: 0 10px 24px -10px hsl(var(--brand) / 0.55);
	}

	/* Back to top — lifts, glows, and the arrow launches up */
	.back-top {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border-radius: 9999px;
		border: 1px solid hsl(var(--border));
		background: hsl(var(--surface));
		padding: 0.6rem 1.25rem;
		font-size: 0.875rem;
		color: hsl(var(--muted-foreground));
		transition:
			transform 0.25s ease,
			color 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}
	.back-top:hover {
		transform: translateY(-3px);
		color: hsl(var(--foreground));
		border-color: hsl(var(--foreground) / 0.15);
		box-shadow: 0 12px 28px -12px hsl(var(--brand) / 0.55);
	}
	.back-top svg {
		transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.back-top:hover svg {
		transform: translateY(-3px);
	}

	/* Giant faded sign-off across the bottom */
	.wordmark {
		position: relative;
		z-index: 1;
		margin-top: 4rem;
		padding-bottom: 1.5rem;
		text-align: center;
		font-weight: 800;
		font-size: clamp(3.2rem, 17vw, 15rem);
		line-height: 0.9;
		letter-spacing: -0.04em;
		white-space: nowrap;
		color: transparent;
		background: linear-gradient(
			to bottom,
			hsl(var(--foreground) / 0.09),
			hsl(var(--foreground) / 0)
		);
		-webkit-background-clip: text;
		background-clip: text;
		pointer-events: none;
		user-select: none;
	}
</style>

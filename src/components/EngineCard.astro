---
import type { Project } from "../data/projects";
import { ArrowUpRight } from "lucide-react";

interface Props {
	project: Project;
}

const { project } = Astro.props;
const isActive = project.status === "active";
const initial = project.title.trim().charAt(0).toUpperCase();

let domain = "";
try {
	if (project.href && project.href !== "#") {
		domain = new URL(project.href).hostname.replace(/^www\./, "");
	}
} catch (e) {
	domain = "";
}
---

<a
	href={`/projects/${project.slug}`}
	data-glow
	class="group ring-gradient relative flex flex-col overflow-hidden rounded-2xl border border-border bg-surface transition-all duration-500 hover:-translate-y-1 hover:border-transparent hover:shadow-2xl"
>
	<!-- Cursor-follow glow -->
	<div class="engine-glow" aria-hidden="true"></div>

	<!-- Visual -->
	<div class="relative aspect-[16/10] overflow-hidden border-b border-border">
		{
			project.image ? (
				<img
					src={project.image}
					alt={`${project.title} screenshot`}
					loading="lazy"
					decoding="async"
					class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
				/>
			) : (
				<div class="absolute inset-0 grid place-items-center bg-gradient-to-br from-brand/20 via-surface to-surface-2">
					<span class="font-mono text-5xl font-bold text-foreground/10">
						{initial}
					</span>
				</div>
			)
		}
		{
			project.stats && (
				<span
					class:list={[
						"absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[11.5px] font-medium backdrop-blur",
						isActive
							? "border-live/25 bg-background/70 text-live"
							: "border-border bg-background/70 text-muted-foreground",
					]}
				>
					{isActive && (
						<span class="relative flex h-1.5 w-1.5">
							<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-live opacity-75" />
							<span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-live" />
						</span>
					)}
					{project.stats}
				</span>
			)
		}
	</div>

	<!-- Content -->
	<div class="relative z-10 flex flex-1 flex-col p-5">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<h3
					class="truncate text-lg font-semibold tracking-tight transition-colors group-hover:text-brand-2"
				>
					{project.title}
				</h3>
				{
					domain && (
						<p class="mt-0.5 truncate font-mono text-[12px] text-brand-2/80">
							{domain}
						</p>
					)
				}
			</div>
			<div
				class="grid h-8 w-8 flex-none place-items-center rounded-full border border-border text-muted-foreground transition-all duration-500 group-hover:rotate-45 group-hover:border-transparent group-hover:bg-brand group-hover:text-brand-foreground"
			>
				<ArrowUpRight className="h-4 w-4" />
			</div>
		</div>

		<p
			class="mt-3 line-clamp-2 flex-1 text-sm leading-relaxed text-muted-foreground"
		>
			{project.description}
		</p>

		<div class="mt-4 flex flex-wrap gap-1.5">
			{
				project.tags.slice(0, 3).map((tag) => (
					<span class="rounded-md border border-border bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-muted-foreground">
						{tag}
					</span>
				))
			}
		</div>
	</div>
</a>

<style>
	.engine-glow {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 0.5s ease;
		background: radial-gradient(
			420px circle at var(--mx, 50%) var(--my, 0%),
			hsl(var(--brand) / 0.13),
			transparent 45%
		);
	}
	.group:hover .engine-glow {
		opacity: 1;
	}
</style>

<script>
	// Wire cursor-follow glow for all engine cards (runs once per page).
	document.querySelectorAll<HTMLElement>("[data-glow]").forEach((card) => {
		card.addEventListener("pointermove", (e) => {
			const r = card.getBoundingClientRect();
			card.style.setProperty("--mx", `${((e.clientX - r.left) / r.width) * 100}%`);
			card.style.setProperty("--my", `${((e.clientY - r.top) / r.height) * 100}%`);
		});
	});
</script>

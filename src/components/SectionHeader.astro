---
interface Props {
	title: string;
	subtitle?: string;
	align?: "left" | "center";
}

const { title, subtitle, align = "left" } = Astro.props;
---

<div class:list={["mb-8 md:mb-12", align === "center" && "text-center"]}>
	<h2
		class="bg-gradient-to-br from-foreground to-foreground/60 bg-clip-text text-3xl font-semibold tracking-tight text-transparent md:text-4xl"
	>
		{title}
	</h2>
	{
		subtitle && (
			<p
				class:list={[
					"mt-3 max-w-2xl text-lg leading-relaxed text-muted-foreground",
					align === "center" && "mx-auto",
				]}
			>
				{subtitle}
			</p>
		)
	}
</div>

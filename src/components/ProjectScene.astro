---
import type { Project } from "../data/projects";
import { ArrowUpRight, ArrowRight, Lock } from "lucide-react";

interface Props {
	project: Project;
	index: number;
}

const { project, index } = Astro.props;
const num = String(index + 1).padStart(2, "0");
const reversed = index % 2 === 1;
const initial = project.title.trim().charAt(0).toUpperCase();
const accent = project.accent ?? "217 91% 60%";
const category = project.tags?.[0] ?? "";
const mock = project.mock ?? "gallery";
const highlights = project.highlights ?? [];

let domain = "";
try {
	if (project.href && project.href !== "#") {
		domain = new URL(project.href).hostname.replace(/^www\./, "");
	}
} catch (e) {
	domain = "";
}
const hasLive = !!domain;

// Repeated elements for the live mock UIs
const galleryCells = Array.from({ length: 12 }, (_, i) =>
	(((i % 4) * 0.18 + Math.floor(i / 4) * 0.22) % 2.2).toFixed(2),
);
const audioBars = Array.from({ length: 20 }, (_, i) =>
	(-(i % 7) * 0.16 - (i % 3) * 0.1).toFixed(2),
);
const latticeDots = Array.from(
	{ length: 35 },
	(_, i) => (((i % 7) + Math.floor(i / 7)) * 0.13).toFixed(2),
);
const pins = [
	{ top: "24%", left: "20%", d: "0s" },
	{ top: "60%", left: "38%", d: "0.6s" },
	{ top: "32%", left: "64%", d: "1.1s" },
	{ top: "70%", left: "78%", d: "1.7s" },
];
---

<section
	class="scene"
	id={`scene-${index}`}
	data-scene
	style={`--accent:${accent};`}
>
	<div class="scene-glow" aria-hidden="true"></div>

	<div class="relative mx-auto grid items-stretch gap-10 lg:grid-cols-2 lg:gap-16">
		<!-- Visual (pins on desktop) -->
		<div class:list={["visual-col", reversed ? "lg:order-1" : "lg:order-2"]}>
			<div class="visual-sticky" data-tilt>
				<span class="watermark" aria-hidden="true">{num}</span>
				<div class="browser" data-tilt-inner>
					<div class="browser-bar">
						<span class="tl"></span>
						<span class="tl"></span>
						<span class="tl"></span>
						<span class="address">
							<Lock className="h-3 w-3 opacity-60" />
							{domain || project.slug}
						</span>
					</div>
					<div class="browser-body">
						{
							project.image ? (
								<img
									src={project.image}
									alt={`${project.title} screenshot`}
									loading="lazy"
									decoding="async"
								/>
							) : (
								<div class="mock" data-mock={mock}>
									{mock === "gallery" &&
										galleryCells.map((d) => <i style={`--d:${d}s`} />)}
									{mock === "audio" &&
										audioBars.map((d) => <i style={`--d:${d}s`} />)}
									{mock === "lattice" &&
										latticeDots.map((d) => <i style={`--d:${d}s`} />)}
									{mock === "community" && (
										<>
											<div class="field" />
											{pins.map((p) => (
												<span
													class="pin"
													style={`top:${p.top};left:${p.left};--d:${p.d}`}
												/>
											))}
										</>
									)}
									<span class="mock-tag">{initial}</span>
								</div>
							)
						}
					</div>
				</div>
			</div>
		</div>

		<!-- Content (scrolls past the pinned visual) -->
		<div class:list={["content-col", reversed ? "lg:order-2" : "lg:order-1"]}>
			<div class="blk intro" data-blk>
				<div class="eyebrow-row">
					<span class="num">{num}</span>
					<span class="line" aria-hidden="true"></span>
					{category && <span class="cat">{category}</span>}
				</div>
				<h3 class="title">{project.title}</h3>
				{
					hasLive && (
						<a
							class="domain"
							href={project.href}
							target="_blank"
							rel="noopener noreferrer"
						>
							{domain}
							<ArrowUpRight className="h-3.5 w-3.5" />
						</a>
					)
				}
				<p class="desc">{project.description}</p>
			</div>

			{
				highlights.map((h, k) => (
					<div class="blk hl" data-blk>
						<span class="hl-num">{String(k + 1).padStart(2, "0")}</span>
						<p class="hl-text">{h}</p>
					</div>
				))
			}

			<div class="blk outro" data-blk>
				<div class="tags">
					{project.tags.map((tag) => <span class="tag">{tag}</span>)}
				</div>
				<div class="actions">
					<a class="btn-explore" href={`/projects/${project.slug}`}>
						Explore the project
						<ArrowRight className="h-4 w-4" />
					</a>
					{
						hasLive && (
							<a
								class="btn-visit"
								href={project.href}
								target="_blank"
								rel="noopener noreferrer"
							>
								Visit live
								<ArrowUpRight className="h-4 w-4" />
							</a>
						)
					}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.scene {
		position: relative;
		padding-block: clamp(3rem, 8vh, 6rem);
	}
	.scene > div:nth-child(2) {
		position: relative;
		z-index: 1;
	}

	/* Per-project world */
	.scene-glow {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 100vw;
		height: 120%;
		transform: translate(-50%, -50%);
		z-index: 0;
		pointer-events: none;
		background: radial-gradient(
			ellipse 40% 44% at 50% 50%,
			hsl(var(--accent) / 0.16),
			transparent 72%
		);
		opacity: 0;
		transition: opacity 1.2s ease;
	}
	.scene.in .scene-glow {
		opacity: 1;
	}

	/* Visual + sticky pin */
	.visual-sticky {
		position: relative;
		perspective: 1300px;
	}
	@media (min-width: 1024px) {
		.visual-sticky {
			position: sticky;
			top: 50%;
			transform: translateY(-50%);
		}
	}
	.watermark {
		position: absolute;
		top: -2.6rem;
		left: -0.6rem;
		z-index: 0;
		font-family: "Geist Mono", ui-monospace, monospace;
		font-weight: 700;
		font-size: clamp(5rem, 13vw, 10rem);
		line-height: 1;
		color: hsl(var(--accent) / 0.12);
		pointer-events: none;
		user-select: none;
	}
	.browser {
		position: relative;
		z-index: 1;
		border-radius: 14px;
		border: 1px solid hsl(var(--border));
		background: hsl(var(--surface));
		overflow: hidden;
		transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
		transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
		box-shadow:
			0 44px 100px -40px hsl(var(--accent) / 0.45),
			0 18px 50px -28px rgba(0, 0, 0, 0.6);
	}
	.browser-bar {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.6rem 0.85rem;
		border-bottom: 1px solid hsl(var(--border));
		background: hsl(var(--surface-2));
	}
	.browser-bar .tl {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: hsl(var(--border));
	}
	.address {
		margin-left: 0.5rem;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		max-width: 70%;
		padding: 0.2rem 0.7rem;
		border: 1px solid hsl(var(--border));
		border-radius: 999px;
		background: hsl(var(--background) / 0.5);
		font-family: "Geist Mono", ui-monospace, monospace;
		font-size: 0.72rem;
		color: hsl(var(--muted-foreground));
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.browser-body {
		position: relative;
		aspect-ratio: 16 / 10;
		background: hsl(var(--surface-2));
	}
	.browser-body img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* ---- Live mock UIs ---- */
	.mock {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background: linear-gradient(
			160deg,
			hsl(var(--accent) / 0.1),
			hsl(var(--surface-2))
		);
	}
	.mock-tag {
		position: absolute;
		right: 0.7rem;
		bottom: 0.5rem;
		font-family: "Geist Mono", ui-monospace, monospace;
		font-weight: 700;
		font-size: 1.6rem;
		color: hsl(var(--foreground) / 0.1);
	}

	/* gallery: shimmering tile grid */
	.mock[data-mock="gallery"] {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		grid-auto-rows: 1fr;
		gap: 7px;
		padding: 14px;
	}
	.mock[data-mock="gallery"] i {
		border-radius: 7px;
		background: linear-gradient(
			135deg,
			hsl(var(--accent) / 0.65),
			hsl(var(--accent) / 0.12)
		);
		animation: gpulse 3.6s ease-in-out infinite;
		animation-delay: var(--d, 0s);
	}
	@keyframes gpulse {
		0%,
		100% {
			opacity: 0.35;
			filter: saturate(0.8);
		}
		50% {
			opacity: 1;
			filter: saturate(1.3);
		}
	}

	/* audio: equalizer */
	.mock[data-mock="audio"] {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: 5px;
		padding: 16px 18px;
	}
	.mock[data-mock="audio"] i {
		width: 6px;
		height: 42%;
		border-radius: 3px;
		background: linear-gradient(
			to top,
			hsl(var(--accent)),
			hsl(var(--accent) / 0.35)
		);
		animation: bars 1.1s ease-in-out infinite;
		animation-delay: var(--d, 0s);
	}
	@keyframes bars {
		0%,
		100% {
			height: 16%;
		}
		50% {
			height: 86%;
		}
	}

	/* lattice: structured network breathing in a wave */
	.mock[data-mock="lattice"] {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		grid-auto-rows: 1fr;
		place-items: center;
		padding: 22px;
	}
	.mock[data-mock="lattice"] i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: hsl(var(--accent));
		opacity: 0.25;
		animation: latpulse 2.8s ease-in-out infinite;
		animation-delay: var(--d, 0s);
	}
	@keyframes latpulse {
		0%,
		100% {
			opacity: 0.18;
			transform: scale(0.8);
		}
		50% {
			opacity: 1;
			transform: scale(1.3);
		}
	}

	/* community: discovery map with pulsing pins */
	.mock[data-mock="community"] .field {
		position: absolute;
		inset: 0;
		background-image: radial-gradient(
			hsl(var(--accent) / 0.16) 1.5px,
			transparent 1.5px
		);
		background-size: 22px 22px;
	}
	.mock[data-mock="community"] .pin {
		position: absolute;
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: hsl(var(--accent));
		box-shadow: 0 0 12px hsl(var(--accent) / 0.7);
	}
	.mock[data-mock="community"] .pin::after {
		content: "";
		position: absolute;
		inset: -5px;
		border-radius: 50%;
		border: 2px solid hsl(var(--accent) / 0.6);
		animation: ping2 2.4s ease-out infinite;
		animation-delay: var(--d, 0s);
	}
	@keyframes ping2 {
		0% {
			transform: scale(0.5);
			opacity: 0.9;
		}
		100% {
			transform: scale(2);
			opacity: 0;
		}
	}

	/* ---- Content ---- */
	.content-col {
		display: flex;
		flex-direction: column;
		gap: clamp(2rem, 5vh, 4rem);
	}
	@media (min-width: 1024px) {
		.content-col {
			gap: 0;
			padding-block: 8vh;
		}
		.content-col .hl {
			min-height: 28vh;
			justify-content: center;
		}
		.content-col .outro {
			margin-top: 10vh;
		}
	}
	.blk {
		display: flex;
		flex-direction: column;
	}
	.eyebrow-row {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		font-family: "Geist Mono", ui-monospace, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: hsl(var(--accent));
	}
	.eyebrow-row .num {
		font-weight: 600;
	}
	.eyebrow-row .line {
		height: 1px;
		width: 2rem;
		background: hsl(var(--accent) / 0.5);
	}
	.eyebrow-row .cat {
		color: hsl(var(--subtle));
	}
	.title {
		margin-top: 1.1rem;
		font-size: clamp(2.1rem, 4.6vw, 3.4rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.04;
	}
	.domain {
		margin-top: 0.7rem;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-family: "Geist Mono", ui-monospace, monospace;
		font-size: 0.85rem;
		color: hsl(var(--accent));
	}
	.domain:hover {
		opacity: 0.82;
	}
	.desc {
		margin-top: 1.2rem;
		max-width: 30rem;
		font-size: 1.0625rem;
		line-height: 1.65;
		color: hsl(var(--muted-foreground));
	}
	.hl {
		gap: 0.45rem;
	}
	.hl-num {
		font-family: "Geist Mono", ui-monospace, monospace;
		font-size: 0.8rem;
		color: hsl(var(--accent));
	}
	.hl-text {
		font-size: clamp(1.25rem, 2.4vw, 1.7rem);
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.3;
		color: hsl(var(--foreground));
		max-width: 26rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.tag {
		padding: 0.25rem 0.65rem;
		border-radius: 0.5rem;
		border: 1px solid hsl(var(--border));
		background: hsl(var(--accent) / 0.06);
		font-family: "Geist Mono", ui-monospace, monospace;
		font-size: 0.72rem;
		color: hsl(var(--muted-foreground));
	}
	.actions {
		margin-top: 1.6rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.btn-explore {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.7rem 1.3rem;
		border-radius: 999px;
		border: 1px solid hsl(var(--accent) / 0.5);
		background: hsl(var(--accent) / 0.1);
		color: hsl(var(--accent));
		font-weight: 500;
		font-size: 0.95rem;
		transition:
			transform 0.25s ease,
			background 0.25s ease,
			border-color 0.25s ease,
			gap 0.25s ease;
	}
	.btn-explore:hover {
		transform: translateY(-2px);
		gap: 0.7rem;
		background: hsl(var(--accent) / 0.18);
		border-color: hsl(var(--accent));
	}
	.btn-visit {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.7rem 1.1rem;
		border-radius: 999px;
		color: hsl(var(--muted-foreground));
		font-weight: 500;
		font-size: 0.95rem;
		transition:
			color 0.25s ease,
			gap 0.25s ease;
	}
	.btn-visit:hover {
		color: hsl(var(--foreground));
		gap: 0.7rem;
	}

	/* Reveal */
	:global(.js) .blk {
		opacity: 0;
		transform: translateY(20px);
		transition:
			opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
			transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	:global(.js) .visual-sticky {
		opacity: 0;
		transition: opacity 0.9s ease;
	}
	.blk.in {
		opacity: 1;
		transform: none;
	}
	.scene.in .visual-sticky {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.js) .blk {
			opacity: 1;
			transform: none;
			transition: none;
		}
		:global(.js) .visual-sticky {
			opacity: 1;
			transition: none;
		}
		.browser,
		.mock i,
		.mock .pin::after {
			animation: none !important;
			transition: none;
		}
	}
</style>

<script>
	(function () {
		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		// Reveal scenes (glow + visual) and content blocks as they enter
		if ("IntersectionObserver" in window) {
			const sceneIO = new IntersectionObserver(
				(entries) => {
					entries.forEach((en) => {
						if (en.isIntersecting) {
							en.target.classList.add("in");
							sceneIO.unobserve(en.target);
						}
					});
				},
				{ threshold: 0.15 },
			);
			document
				.querySelectorAll("[data-scene]")
				.forEach((s) => sceneIO.observe(s));

			const blkIO = new IntersectionObserver(
				(entries) => {
					entries.forEach((en) => {
						if (en.isIntersecting) {
							en.target.classList.add("in");
							blkIO.unobserve(en.target);
						}
					});
				},
				{ threshold: 0.4, rootMargin: "0px 0px -12% 0px" },
			);
			document.querySelectorAll("[data-blk]").forEach((b) => blkIO.observe(b));
		} else {
			document
				.querySelectorAll("[data-scene], [data-blk]")
				.forEach((el) => el.classList.add("in"));
		}

		if (reduce) return;

		// Cursor tilt on each browser mock
		document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((wrap) => {
			const inner = wrap.querySelector<HTMLElement>("[data-tilt-inner]");
			if (!inner) return;
			wrap.addEventListener("pointermove", (e) => {
				const r = wrap.getBoundingClientRect();
				const px = (e.clientX - r.left) / r.width - 0.5;
				const py = (e.clientY - r.top) / r.height - 0.5;
				inner.style.setProperty("--ry", (px * 6).toFixed(2) + "deg");
				inner.style.setProperty("--rx", (-py * 6).toFixed(2) + "deg");
			});
			wrap.addEventListener("pointerleave", () => {
				inner.style.setProperty("--ry", "0deg");
				inner.style.setProperty("--rx", "0deg");
			});
		});
	})();
</script>

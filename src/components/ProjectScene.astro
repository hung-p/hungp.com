---
import type { Project } from "../data/projects";
import { ArrowUpRight, ArrowRight, Lock } from "lucide-react";

interface Props {
	project: Project;
	index: number;
}

const { project, index } = Astro.props;
const num = String(index + 1).padStart(2, "0");
const reversed = index % 2 === 1;
const initial = project.title.trim().charAt(0).toUpperCase();
const accent = project.accent ?? "217 91% 60%";
const category = project.tags?.[0] ?? "";

let domain = "";
try {
	if (project.href && project.href !== "#") {
		domain = new URL(project.href).hostname.replace(/^www\./, "");
	}
} catch (e) {
	domain = "";
}
const hasLive = !!domain;
---

<section class="scene" data-scene style={`--accent:${accent};`}>
	<!-- per-project ambient world -->
	<div class="scene-glow" aria-hidden="true"></div>

	<div
		class:list={[
			"relative mx-auto grid items-center gap-10 lg:grid-cols-2 lg:gap-16",
		]}
	>
		<!-- Visual -->
		<div
			class:list={[
				"visual",
				reversed ? "lg:order-1" : "lg:order-2",
			]}
			data-parallax
			data-tilt
		>
			<span class="watermark" aria-hidden="true">{num}</span>
			<div class="browser" data-tilt-inner>
				<div class="browser-bar">
					<span class="tl"></span>
					<span class="tl"></span>
					<span class="tl"></span>
					<span class="address">
						<Lock className="h-3 w-3 opacity-60" />
						{domain || project.slug}
					</span>
				</div>
				<div class="browser-body">
					{
						project.image ? (
							<img
								src={project.image}
								alt={`${project.title} screenshot`}
								loading="lazy"
								decoding="async"
							/>
						) : (
							<div class="ph">
								<span>{initial}</span>
							</div>
						)
					}
				</div>
			</div>
		</div>

		<!-- Content -->
		<div
			class:list={[
				"content",
				reversed ? "lg:order-2" : "lg:order-1",
			]}
		>
			<div class="reveal-c eyebrow-row">
				<span class="num">{num}</span>
				<span class="line" aria-hidden="true"></span>
				{category && <span class="cat">{category}</span>}
			</div>

			<h3 class="reveal-c title">{project.title}</h3>

			{
				hasLive && (
					<a
						class="reveal-c domain"
						href={project.href}
						target="_blank"
						rel="noopener noreferrer"
					>
						{domain}
						<ArrowUpRight className="h-3.5 w-3.5" />
					</a>
				)
			}

			<p class="reveal-c desc">{project.description}</p>

			<div class="reveal-c tags">
				{
					project.tags.map((tag) => (
						<span class="tag">{tag}</span>
					))
				}
			</div>

			<div class="reveal-c actions">
				<a class="btn-explore" href={`/projects/${project.slug}`}>
					Explore the project
					<ArrowRight className="h-4 w-4" />
				</a>
				{
					hasLive && (
						<a
							class="btn-visit"
							href={project.href}
							target="_blank"
							rel="noopener noreferrer"
						>
							Visit live
							<ArrowUpRight className="h-4 w-4" />
						</a>
					)
				}
			</div>
		</div>
	</div>
</section>

<style>
	.scene {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 78vh;
		padding-block: clamp(3rem, 9vh, 6rem);
	}
	.scene > .grid,
	.scene > div:nth-child(2) {
		position: relative;
		z-index: 1;
		width: 100%;
	}

	/* Full-bleed accent world */
	.scene-glow {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 100vw;
		height: 130%;
		transform: translate(-50%, -50%);
		z-index: 0;
		pointer-events: none;
		background: radial-gradient(
			ellipse 40% 46% at 50% 50%,
			hsl(var(--accent) / 0.16),
			transparent 72%
		);
		opacity: 0;
		transition: opacity 1.1s ease;
	}
	.scene.in .scene-glow {
		opacity: 1;
	}

	/* Visual + browser mock */
	.visual {
		position: relative;
		perspective: 1300px;
	}
	.watermark {
		position: absolute;
		top: -2.8rem;
		left: -0.5rem;
		z-index: 0;
		font-family: "Geist Mono", ui-monospace, monospace;
		font-weight: 700;
		font-size: clamp(5rem, 15vw, 11rem);
		line-height: 1;
		color: hsl(var(--accent) / 0.12);
		pointer-events: none;
		user-select: none;
	}
	.browser {
		position: relative;
		z-index: 1;
		border-radius: 14px;
		border: 1px solid hsl(var(--border));
		background: hsl(var(--surface));
		overflow: hidden;
		transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg))
			translateY(var(--shift, 0px));
		transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
		box-shadow:
			0 40px 90px -36px hsl(var(--accent) / 0.4),
			0 16px 50px -24px rgba(0, 0, 0, 0.55);
	}
	.browser-bar {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.6rem 0.85rem;
		border-bottom: 1px solid hsl(var(--border));
		background: hsl(var(--surface-2));
	}
	.browser-bar .tl {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: hsl(var(--border));
	}
	.address {
		margin-left: 0.5rem;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		max-width: 70%;
		padding: 0.2rem 0.7rem;
		border: 1px solid hsl(var(--border));
		border-radius: 999px;
		background: hsl(var(--background) / 0.5);
		font-family: "Geist Mono", ui-monospace, monospace;
		font-size: 0.72rem;
		color: hsl(var(--muted-foreground));
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.browser-body {
		position: relative;
		aspect-ratio: 16 / 10;
	}
	.browser-body img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.ph {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		background:
			radial-gradient(
				circle at 28% 22%,
				hsl(var(--accent) / 0.3),
				transparent 55%
			),
			linear-gradient(155deg, hsl(var(--accent) / 0.14), hsl(var(--surface-2)));
	}
	.ph span {
		font-family: "Geist Mono", ui-monospace, monospace;
		font-weight: 700;
		font-size: clamp(3rem, 7vw, 5rem);
		color: hsl(var(--foreground) / 0.14);
	}

	/* Content */
	.eyebrow-row {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		font-family: "Geist Mono", ui-monospace, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: hsl(var(--accent));
	}
	.eyebrow-row .num {
		font-weight: 600;
	}
	.eyebrow-row .line {
		height: 1px;
		width: 2rem;
		background: hsl(var(--accent) / 0.5);
	}
	.eyebrow-row .cat {
		color: hsl(var(--subtle));
	}
	.title {
		margin-top: 1.1rem;
		font-size: clamp(2.1rem, 4.6vw, 3.4rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.04;
	}
	.domain {
		margin-top: 0.7rem;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-family: "Geist Mono", ui-monospace, monospace;
		font-size: 0.85rem;
		color: hsl(var(--accent));
		transition: opacity 0.2s ease;
	}
	.domain:hover {
		opacity: 0.8;
	}
	.desc {
		margin-top: 1.2rem;
		max-width: 30rem;
		font-size: 1.0625rem;
		line-height: 1.65;
		color: hsl(var(--muted-foreground));
	}
	.tags {
		margin-top: 1.4rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.tag {
		padding: 0.25rem 0.65rem;
		border-radius: 0.5rem;
		border: 1px solid hsl(var(--border));
		background: hsl(var(--accent) / 0.06);
		font-family: "Geist Mono", ui-monospace, monospace;
		font-size: 0.72rem;
		color: hsl(var(--muted-foreground));
	}
	.actions {
		margin-top: 1.9rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.btn-explore {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.7rem 1.3rem;
		border-radius: 999px;
		border: 1px solid hsl(var(--accent) / 0.5);
		background: hsl(var(--accent) / 0.1);
		color: hsl(var(--accent));
		font-weight: 500;
		font-size: 0.95rem;
		transition:
			transform 0.25s ease,
			background 0.25s ease,
			border-color 0.25s ease,
			gap 0.25s ease;
	}
	.btn-explore:hover {
		transform: translateY(-2px);
		gap: 0.7rem;
		background: hsl(var(--accent) / 0.18);
		border-color: hsl(var(--accent));
	}
	.btn-visit {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.7rem 1.1rem;
		border-radius: 999px;
		color: hsl(var(--muted-foreground));
		font-weight: 500;
		font-size: 0.95rem;
		transition:
			color 0.25s ease,
			gap 0.25s ease;
	}
	.btn-visit:hover {
		color: hsl(var(--foreground));
		gap: 0.7rem;
	}

	/* Scroll reveal (only when JS is active) */
	:global(.js) .reveal-c {
		opacity: 0;
		transform: translateY(22px);
		transition:
			opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
			transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	:global(.js) .visual {
		opacity: 0;
		transform: translateY(30px) scale(0.97);
		transition:
			opacity 0.9s ease,
			transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.scene.in .reveal-c,
	.scene.in .visual {
		opacity: 1;
		transform: none;
	}
	.scene.in .reveal-c:nth-child(2) {
		transition-delay: 0.08s;
	}
	.scene.in .reveal-c:nth-child(3) {
		transition-delay: 0.14s;
	}
	.scene.in .reveal-c:nth-child(4) {
		transition-delay: 0.2s;
	}
	.scene.in .reveal-c:nth-child(5) {
		transition-delay: 0.26s;
	}
	.scene.in .reveal-c:nth-child(6) {
		transition-delay: 0.32s;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.js) .reveal-c,
		:global(.js) .visual {
			opacity: 1;
			transform: none;
			transition: none;
		}
		.browser {
			transition: none;
		}
	}
</style>

<script>
	(function () {
		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const scenes = Array.from(
			document.querySelectorAll<HTMLElement>("[data-scene]"),
		);
		if (!scenes.length) return;

		// Reveal each scene as it enters
		if ("IntersectionObserver" in window) {
			const io = new IntersectionObserver(
				(entries) => {
					entries.forEach((en) => {
						if (en.isIntersecting) {
							en.target.classList.add("in");
							io.unobserve(en.target);
						}
					});
				},
				{ threshold: 0.2, rootMargin: "0px 0px -10% 0px" },
			);
			scenes.forEach((s) => io.observe(s));
		} else {
			scenes.forEach((s) => s.classList.add("in"));
		}

		if (reduce) return;

		// Parallax: drift the browser mock as the scene scrolls past
		const parallax = Array.from(
			document.querySelectorAll<HTMLElement>("[data-parallax]"),
		);
		let ticking = false;
		const update = () => {
			const vh = window.innerHeight;
			for (const el of parallax) {
				const r = el.getBoundingClientRect();
				const center = r.top + r.height / 2;
				const shift = Math.max(-26, Math.min(26, (vh / 2 - center) * 0.045));
				el.style.setProperty("--shift", shift.toFixed(1) + "px");
			}
			ticking = false;
		};
		window.addEventListener(
			"scroll",
			() => {
				if (!ticking) {
					requestAnimationFrame(update);
					ticking = true;
				}
			},
			{ passive: true },
		);
		window.addEventListener("resize", update);
		update();

		// Cursor tilt on each browser mock
		document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((wrap) => {
			const inner = wrap.querySelector<HTMLElement>("[data-tilt-inner]");
			if (!inner) return;
			wrap.addEventListener("pointermove", (e) => {
				const r = wrap.getBoundingClientRect();
				const px = (e.clientX - r.left) / r.width - 0.5;
				const py = (e.clientY - r.top) / r.height - 0.5;
				inner.style.setProperty("--ry", (px * 7).toFixed(2) + "deg");
				inner.style.setProperty("--rx", (-py * 7).toFixed(2) + "deg");
			});
			wrap.addEventListener("pointerleave", () => {
				inner.style.setProperty("--ry", "0deg");
				inner.style.setProperty("--rx", "0deg");
			});
		});
	})();
</script>

---
import type { Project } from "../data/projects";
import { ArrowUpRight } from "lucide-react";

interface Props {
	project: Project;
	size?: "default" | "compact";
}

const { project, size = "default" } = Astro.props;
const isCompact = size === "compact";
---

<a
	href={`/projects/${project.slug}`}
	class:list={[
		"group block rounded-2xl border border-border bg-surface transition-all duration-300 hover:-translate-y-1 hover:border-foreground/15 hover:bg-surface-2",
		isCompact ? "p-4" : "p-5",
	]}
>
	<div class="mb-2 flex items-start justify-between gap-2">
		<h3
			class:list={[
				"font-semibold tracking-tight transition-colors group-hover:text-brand-2",
				isCompact ? "text-[15px]" : "text-lg",
			]}
		>
			{project.title}
		</h3>
		<ArrowUpRight
			className="h-4 w-4 flex-none text-subtle opacity-0 transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-brand-2 group-hover:opacity-100"
		/>
	</div>

	{
		!isCompact && (
			<p class="mb-3 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
				{project.description}
			</p>
		)
	}

	<div class="flex flex-wrap gap-1.5">
		{
			project.tags.slice(0, 3).map((tag) => (
				<span class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-[10.5px] text-subtle">
					{tag}
				</span>
			))
		}
	</div>
</a>

---
import type { Project } from "../data/projects";

interface Props {
	projects: Project[];
}

const { projects } = Astro.props;
---

<div class="rail" data-rail-wrap aria-hidden="true">
	{
		projects.map((p, i) => (
			<button
				type="button"
				class="dot"
				data-rail={i}
				style={`--accent:${p.accent ?? "217 91% 60%"}`}
				aria-label={`Go to ${p.title}`}
			>
				<span class="n">{String(i + 1).padStart(2, "0")}</span>
				<span class="tip">{p.title}</span>
			</button>
		))
	}
</div>

<style>
	.rail {
		position: fixed;
		right: 1.6rem;
		top: 50%;
		transform: translateY(-50%);
		z-index: 40;
		display: none;
		flex-direction: column;
		gap: 0.85rem;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}
	@media (min-width: 1280px) {
		.rail {
			display: flex;
		}
	}
	.rail.visible {
		opacity: 1;
		pointer-events: auto;
	}
	.dot {
		position: relative;
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		border: 1px solid hsl(var(--border));
		background: hsl(var(--surface) / 0.6);
		backdrop-filter: blur(6px);
		color: hsl(var(--subtle));
		font-family: "Geist Mono", ui-monospace, monospace;
		font-size: 0.62rem;
		cursor: pointer;
		transition:
			color 0.3s ease,
			background 0.3s ease,
			border-color 0.3s ease,
			box-shadow 0.3s ease;
	}
	.dot:hover {
		color: hsl(var(--foreground));
		border-color: hsl(var(--foreground) / 0.2);
	}
	.dot.active {
		border-color: transparent;
		background: hsl(var(--accent));
		color: #fff;
		box-shadow:
			0 0 0 4px hsl(var(--accent) / 0.18),
			0 6px 22px -6px hsl(var(--accent) / 0.6);
	}
	.tip {
		position: absolute;
		right: 2.6rem;
		white-space: nowrap;
		padding: 0.25rem 0.6rem;
		border-radius: 0.5rem;
		background: hsl(var(--foreground));
		color: hsl(var(--background));
		font-family: "Geist Sans", sans-serif;
		font-size: 0.72rem;
		opacity: 0;
		transform: translateX(6px);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
		pointer-events: none;
	}
	.dot:hover .tip,
	.dot.active .tip {
		opacity: 1;
		transform: none;
	}
</style>

<script>
	(function () {
		const rail = document.querySelector<HTMLElement>("[data-rail-wrap]");
		const dots = Array.from(
			document.querySelectorAll<HTMLElement>("[data-rail]"),
		);
		const scenes = Array.from(
			document.querySelectorAll<HTMLElement>("[data-scene]"),
		);
		const work = document.getElementById("work");
		if (!rail || !dots.length || !scenes.length) return;

		if ("IntersectionObserver" in window) {
			// Which scene owns the center of the viewport?
			const io = new IntersectionObserver(
				(entries) => {
					entries.forEach((en) => {
						if (en.isIntersecting) {
							const idx = scenes.indexOf(en.target as HTMLElement);
							dots.forEach((d, k) => d.classList.toggle("active", k === idx));
						}
					});
				},
				{ rootMargin: "-48% 0px -48% 0px", threshold: 0 },
			);
			scenes.forEach((s) => io.observe(s));

			// Only show the rail while the showcase is on screen
			if (work) {
				const vio = new IntersectionObserver(
					(entries) => {
						entries.forEach((en) =>
							rail.classList.toggle("visible", en.isIntersecting),
						);
					},
					{ rootMargin: "-10% 0px -10% 0px", threshold: 0 },
				);
				vio.observe(work);
			}
		}

		dots.forEach((d, i) => {
			d.addEventListener("click", () => {
				const target = document.getElementById("scene-" + i);
				if (target)
					target.scrollIntoView({ behavior: "smooth", block: "center" });
			});
		});
	})();
</script>

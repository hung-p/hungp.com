---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Dock } from "../components/Dock";
import { ArrowLeft, Blocks } from "lucide-react";
---

<BaseLayout
	title="Page not found | Hung Pham"
	description="That page drifted off the mesh. Let's get you back on track."
	noindex={true}
>
	<section
		class="flex min-h-[72vh] flex-col items-center justify-center text-center"
	>
		<p class="eyebrow mb-6">Error 404</p>

		<h1
			class="bg-gradient-to-b from-brand-2 to-foreground/30 bg-clip-text text-7xl font-bold leading-none tracking-tighter text-transparent md:text-9xl"
		>
			404
		</h1>

		<p class="mt-7 max-w-md text-lg leading-relaxed text-muted-foreground">
			This page drifted off the mesh. The link may be broken, or the page
			has moved somewhere else.
		</p>

		<div class="mt-9 flex flex-wrap justify-center gap-3">
			<a
				href="/"
				class="inline-flex items-center justify-center gap-2 rounded-full bg-brand px-6 py-3 font-medium text-brand-foreground shadow-lg shadow-brand/20 transition-all hover:-translate-y-0.5 hover:gap-3 hover:shadow-xl hover:shadow-brand/30"
			>
				<ArrowLeft className="h-4 w-4" />
				Back home
			</a>
			<a
				href="/projects"
				class="inline-flex items-center justify-center gap-2 rounded-full border border-border bg-surface px-6 py-3 font-medium text-foreground transition-all hover:-translate-y-0.5 hover:border-foreground/15 hover:bg-surface-2"
			>
				<Blocks className="h-4 w-4" />
				See the projects
			</a>
		</div>
	</section>

	<Dock client:load />
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Dock } from "../../components/Dock";
import InsightCard from "../../components/InsightCard.astro";
import { getCollection } from "astro:content";
import { blogCategories } from "../../types";
import { Brain, Rocket, Compass } from "lucide-react";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const aiCvPosts = posts.filter((p) => p.data.category === "ai-cv-lab");
const studioPosts = posts.filter((p) => p.data.category === "studio-notes");
const philosophyPosts = posts.filter(
	(p) => p.data.category === "philosophy-culture"
);
const uncategorizedPosts = posts.filter((p) => !p.data.category);

const categoryIcons = {
	"ai-cv-lab": Brain,
	"studio-notes": Rocket,
	"philosophy-culture": Compass,
};

const sections = [
	{
		id: "ai-cv-lab",
		icon: Brain,
		color: "text-sky-400",
		title: "AI/CV Lab",
		blurb: "Technical deep dives into generative models, computer vision, and AI ethics.",
		posts: aiCvPosts,
		empty: "Research posts coming soon…",
	},
	{
		id: "studio-notes",
		icon: Rocket,
		color: "text-live",
		title: "Building Notes",
		blurb: "Lessons and reflections from building products.",
		posts: studioPosts,
		empty: "Notes coming soon…",
	},
	{
		id: "philosophy-culture",
		icon: Compass,
		color: "text-brand-2",
		title: "Philosophy & Culture",
		blurb: "Broader thoughts on life, creativity, and the human experience.",
		posts: philosophyPosts,
		empty: "Philosophy posts coming soon…",
	},
];
---

<BaseLayout
	title="Research & Thoughts | Hung Pham"
	description="Technical deep-dives, entrepreneurial reflections, and broader thoughts on life and creativity."
>
	<div class="space-y-16 md:space-y-24">
		<!-- Header -->
		<section class="pt-12 md:pt-16">
			<div class="reveal max-w-3xl">
				<p class="eyebrow mb-5">Research &amp; Thoughts</p>
				<h1
					class="text-4xl font-semibold leading-[1.1] tracking-tighter md:text-6xl"
				>
					Deep-dives from the lab, notes on building, and the occasional
					philosophical detour.
				</h1>
				<p class="mt-6 text-lg leading-relaxed text-muted-foreground md:text-xl">
					Bridging the academic and entrepreneurial worlds — technical work
					from the AI/CV lab, reflections on building, and broader
					explorations.
				</p>
			</div>

			<!-- Filter pills -->
			<div class="reveal mt-8 flex flex-wrap gap-2.5">
				<a
					href="#all"
					class="rounded-full bg-foreground px-4 py-2 text-sm font-medium text-background transition-colors"
				>
					All Posts
				</a>
				{
					blogCategories.map((cat) => {
						const Icon = categoryIcons[cat.slug as keyof typeof categoryIcons];
						return (
							<a
								href={`#${cat.slug}`}
								class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:border-foreground/15 hover:text-foreground"
							>
								<Icon className="h-4 w-4" />
								{cat.title}
							</a>
						);
					})
				}
			</div>
		</section>

		<!-- Category sections -->
		{
			sections.map((section) => {
				const Icon = section.icon;
				return (
				<section id={section.id}>
					<div class="reveal mb-6 flex items-center gap-3.5">
						<div class={`grid h-11 w-11 flex-none place-items-center rounded-xl border border-border bg-surface ${section.color}`}>
							<Icon className="h-5 w-5" />
						</div>
						<div>
							<h2 class="text-xl font-semibold tracking-tight md:text-2xl">
								{section.title}
							</h2>
							<p class="text-sm text-muted-foreground">{section.blurb}</p>
						</div>
					</div>

					{section.posts.length > 0 ? (
						<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
							{section.posts.map((post) => (
								<div class="reveal">
									<InsightCard post={post} />
								</div>
							))}
						</div>
					) : (
						<div class="reveal rounded-2xl border border-dashed border-border bg-surface/50 py-10 text-center text-muted-foreground">
							<p>{section.empty}</p>
						</div>
					)}
				</section>
			);
			})
		}

		{
			uncategorizedPosts.length > 0 && (
				<section id="all">
					<div class="reveal mb-6">
						<h2 class="text-xl font-semibold tracking-tight md:text-2xl">
							All Posts
						</h2>
						<p class="text-sm text-muted-foreground">
							Browse all published content.
						</p>
					</div>
					<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
						{uncategorizedPosts.map((post) => (
							<div class="reveal">
								<InsightCard post={post} />
							</div>
						))}
					</div>
				</section>
			)
		}
	</div>

	<Dock client:load />
</BaseLayout>

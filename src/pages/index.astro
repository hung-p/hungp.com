---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Dock } from "../components/Dock";
import EngineCard from "../components/EngineCard.astro";
import InsightCard from "../components/InsightCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { tier1Projects } from "../data/projects";
import { getCollection } from "astro:content";
import { siteConfig } from "../site.config";
import { ArrowRight, Sparkles, MapPin, Zap } from "lucide-react";

// Get latest 3 blog posts
const posts = (await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout>
	<div class="space-y-20 md:space-y-32 pb-32">
		<!-- Hero Section -->
		<section class="relative pt-8 md:pt-16">
			<div class="max-w-4xl">
				<!-- Status Badge -->
				<div
					class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm font-medium mb-8"
				>
					<span class="relative flex h-2 w-2">
						<span
							class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
						></span>
						<span
							class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"
						></span>
					</span>
					Available for AI consulting & collaboration
				</div>

				<!-- Main Headline -->
				<h1
					class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-tighter mb-6 leading-[0.9]"
				>
					<span
						class="bg-clip-text text-transparent bg-gradient-to-b from-foreground via-foreground to-foreground/50"
					>
						Hung Pham.
					</span>
				</h1>

				<!-- Tagline -->
				<p
					class="text-xl md:text-2xl lg:text-3xl text-muted-foreground font-light mb-8 max-w-3xl leading-relaxed"
				>
					{siteConfig.tagline}
				</p>

				<!-- Sub-description -->
				<p
					class="text-base md:text-lg text-muted-foreground/80 max-w-2xl mb-10 leading-relaxed"
				>
					Building intelligent systems at the intersection of computer
					vision and entrepreneurship. From Vietnam to Silicon Valley,
					crafting technology that creates value.
				</p>

				<!-- CTAs -->
				<div class="flex flex-wrap gap-4">
					<a
						href="/studio"
						class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-primary text-primary-foreground font-medium hover:opacity-90 transition-all hover:gap-3"
					>
						<Sparkles className="w-4 h-4" />
						View Studio
						<ArrowRight className="w-4 h-4" />
					</a>
					<a
						href="/about"
						class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-secondary text-secondary-foreground font-medium hover:bg-secondary/80 transition-colors"
					>
						<Zap className="w-4 h-4" />
						Work With Me
					</a>
				</div>

				<!-- Location -->
				<div
					class="flex items-center gap-2 mt-10 text-muted-foreground text-sm"
				>
					<MapPin className="w-4 h-4" />
					<span>{siteConfig.location}</span>
					<span class="text-muted-foreground/50">•</span>
					<span>MS AI @ San Jose State</span>
				</div>
			</div>
		</section>

		<!-- Engines Section (Tier 1 Priority Display) -->
		<section>
			<SectionHeader
				title="Active Engines"
				subtitle="Revenue-generating products and ventures in active development. These are the systems that power the studio."
			/>

			<div class="grid gap-6">
				{tier1Projects.map((project) => <EngineCard project={project} />)}
			</div>

			<div class="mt-8 text-center">
				<a
					href="/studio"
					class="inline-flex items-center gap-2 text-muted-foreground hover:text-primary transition-colors"
				>
					View all projects in the Studio
					<ArrowRight className="w-4 h-4" />
				</a>
			</div>
		</section>

		<!-- Recent Insights Section -->
		<section>
			<SectionHeader
				title="Recent Insights"
				subtitle="Technical deep-dives, entrepreneurial reflections, and thoughts on building at the frontier."
			/>

			<div class="grid md:grid-cols-3 gap-4">
				{posts.map((post) => <InsightCard post={post} />)}
			</div>

			{
				posts.length === 0 && (
					<div class="text-center py-12 text-muted-foreground">
						<p>Research insights coming soon...</p>
					</div>
				)
			}

			<div class="mt-8 text-center">
				<a
					href="/research"
					class="inline-flex items-center gap-2 text-muted-foreground hover:text-primary transition-colors"
				>
					Explore all research & thoughts
					<ArrowRight className="w-4 h-4" />
				</a>
			</div>
		</section>

		<!-- Quick Stats -->
		<section
			class="grid grid-cols-2 md:grid-cols-4 gap-4 py-8 border-y border-white/5"
		>
			<div class="text-center">
				<div class="text-3xl md:text-4xl font-bold text-foreground mb-1">
					60k+
				</div>
				<div class="text-sm text-muted-foreground">Monthly Users</div>
			</div>
			<div class="text-center">
				<div class="text-3xl md:text-4xl font-bold text-foreground mb-1">
					3
				</div>
				<div class="text-sm text-muted-foreground">Active Products</div>
			</div>
			<div class="text-center">
				<div class="text-3xl md:text-4xl font-bold text-foreground mb-1">
					5+
				</div>
				<div class="text-sm text-muted-foreground">Years in Tech</div>
			</div>
			<div class="text-center">
				<div class="text-3xl md:text-4xl font-bold text-foreground mb-1">
					AI/CV
				</div>
				<div class="text-sm text-muted-foreground">Research Focus</div>
			</div>
		</section>
	</div>

	<Dock client:load />
</BaseLayout>

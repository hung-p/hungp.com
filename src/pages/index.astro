---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Dock } from "../components/Dock";
import EngineCard from "../components/EngineCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { tier1Projects } from "../data/projects";
import { ArrowRight, ArrowDown } from "lucide-react";

const featured = tier1Projects.slice(0, 3);

const steps = [
	{ n: "01", word: "Listen" },
	{ n: "02", word: "Build" },
	{ n: "03", word: "Ship" },
	{ n: "04", word: "Iterate" },
];
---

<BaseLayout>
	<div class="space-y-24 md:space-y-36">
		<!-- Hero — full viewport width & height -->
		<section
			id="hero"
			class="relative -mt-8 ml-[calc(50%_-_50vw)] flex min-h-[100svh] w-screen flex-col md:-mt-14"
		>
			<!-- Interactive node-mesh (fills the hero) -->
			<canvas
				id="hero-net"
				class="pointer-events-none absolute inset-0 z-0 h-full w-full"
				aria-hidden="true"></canvas>

			<!-- Centered content -->
			<div
				class="relative z-10 mx-auto flex w-full max-w-[1120px] flex-1 items-center px-4 md:px-8"
			>
				<div class="max-w-3xl py-28">
					<p class="eyebrow reveal">AI Engineer · Builder</p>

					<div class="reveal mt-5">
						<span
							class="inline-flex items-center gap-2 rounded-full border border-live/25 bg-live/10 px-3.5 py-1.5 text-sm font-medium text-live"
						>
							<span class="relative flex h-2 w-2">
								<span
									class="absolute inline-flex h-full w-full animate-ping rounded-full bg-live opacity-75"
								></span>
								<span
									class="relative inline-flex h-2 w-2 rounded-full bg-live"
								></span>
							</span>
							Available for collaboration
						</span>
					</div>

					<p
						class="reveal mt-7 font-mono text-sm tracking-tight text-muted-foreground"
					>
						Hung Pham
					</p>

					<h1
						class="reveal mt-2 text-5xl font-semibold leading-[1.02] tracking-tighter md:text-7xl"
					>
						I build products that people
						<span class="text-brand-2">actually use</span>.
					</h1>

					<p
						class="reveal mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground md:text-xl"
					>
						A handful of personal projects, all in active development —
						each built to solve a real problem and be genuinely useful,
						not just another demo.
					</p>

					<div class="reveal mt-9 flex flex-wrap gap-3">
						<a
							href="/projects"
							class="inline-flex items-center justify-center gap-2 rounded-full bg-brand px-6 py-3 font-medium text-brand-foreground shadow-lg shadow-brand/20 transition-all hover:-translate-y-0.5 hover:gap-3 hover:shadow-xl hover:shadow-brand/30"
						>
							See what I'm building
							<ArrowRight className="h-4 w-4" />
						</a>
						<a
							href="/about"
							class="inline-flex items-center justify-center gap-2 rounded-full border border-border bg-surface px-6 py-3 font-medium text-foreground transition-all hover:-translate-y-0.5 hover:border-foreground/15 hover:bg-surface-2"
						>
							About me
						</a>
					</div>
				</div>
			</div>

			<!-- How I build — one-word process, anchored to the bottom -->
			<div
				class="relative z-10 mx-auto w-full max-w-[1120px] px-4 pb-12 md:px-8"
			>
				<p class="eyebrow mb-4">How I build</p>
				<div
					class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-border bg-border md:grid-cols-4"
				>
					{
						steps.map((s) => (
							<div class="group bg-background px-5 py-6 transition-colors hover:bg-surface">
								<div class="font-mono text-[12px] text-subtle">{s.n}</div>
								<div class="mt-1.5 font-mono text-2xl font-semibold tracking-tight transition-colors group-hover:text-brand-2 md:text-3xl">
									{s.word}
								</div>
							</div>
						))
					}
				</div>
			</div>

			<!-- Scroll cue -->
			<div
				class="pointer-events-none absolute bottom-3 left-1/2 z-10 hidden -translate-x-1/2 text-subtle md:block"
			>
				<ArrowDown className="h-4 w-4 animate-bounce" />
			</div>
		</section>

		<!-- What I'm building -->
		<section>
			<div class="reveal">
				<SectionHeader
					title="What I'm building"
					subtitle="A few personal projects in active development — built to be genuinely useful, and to get better every week."
				/>
			</div>

			<div class="grid gap-5">
				{featured.map((project) => <div class="reveal"><EngineCard project={project} /></div>)}
			</div>

			<div class="mt-8 text-center">
				<a
					href="/projects"
					class="inline-flex items-center gap-2 text-muted-foreground transition-colors hover:text-brand-2"
				>
					See all projects
					<ArrowRight className="h-4 w-4" />
				</a>
			</div>
		</section>
	</div>

	<Dock client:load />
</BaseLayout>

<script>
	// Interactive node-mesh hero effect (conveys network / building feel)
	const canvas = document.getElementById("hero-net") as HTMLCanvasElement | null;
	const ctx = canvas?.getContext("2d") ?? null;

	if (canvas && ctx) {
		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		let w = 0;
		let h = 0;
		let nodes: { x: number; y: number; vx: number; vy: number }[] = [];
		const mouse = { x: -9999, y: -9999 };
		let brand = "217 91% 60%";
		let fg = "0 0% 96%";
		const CONNECT = 132;
		const MOUSE_R = 180;
		let raf = 0;

		const readColors = () => {
			const s = getComputedStyle(document.documentElement);
			brand = s.getPropertyValue("--brand").trim() || brand;
			fg = s.getPropertyValue("--foreground").trim() || fg;
		};

		const resize = () => {
			const r = canvas.getBoundingClientRect();
			w = r.width;
			h = r.height;
			canvas.width = Math.floor(w * dpr);
			canvas.height = Math.floor(h * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			const count = Math.min(110, Math.max(36, Math.floor((w * h) / 17000)));
			nodes = [];
			for (let i = 0; i < count; i++) {
				nodes.push({
					x: Math.random() * w,
					y: Math.random() * h,
					vx: (Math.random() - 0.5) * 0.25,
					vy: (Math.random() - 0.5) * 0.25,
				});
			}
		};

		const step = () => {
			for (const n of nodes) {
				n.x += n.vx;
				n.y += n.vy;
				if (n.x < 0 || n.x > w) n.vx *= -1;
				if (n.y < 0 || n.y > h) n.vy *= -1;
			}
		};

		const draw = () => {
			ctx.clearRect(0, 0, w, h);
			for (let i = 0; i < nodes.length; i++) {
				const a = nodes[i];
				const dm = Math.hypot(a.x - mouse.x, a.y - mouse.y);
				const near = dm < MOUSE_R;
				if (near) {
					const o = (1 - dm / MOUSE_R) * 0.5;
					ctx.strokeStyle = `hsl(${brand} / ${o})`;
					ctx.lineWidth = 1;
					ctx.beginPath();
					ctx.moveTo(a.x, a.y);
					ctx.lineTo(mouse.x, mouse.y);
					ctx.stroke();
				}
				ctx.fillStyle = near ? `hsl(${brand} / 0.9)` : `hsl(${fg} / 0.22)`;
				ctx.beginPath();
				ctx.arc(a.x, a.y, near ? 2.3 : 1.5, 0, Math.PI * 2);
				ctx.fill();
				for (let j = i + 1; j < nodes.length; j++) {
					const b = nodes[j];
					const d = Math.hypot(a.x - b.x, a.y - b.y);
					if (d < CONNECT) {
						ctx.strokeStyle = `hsl(${fg} / ${(1 - d / CONNECT) * 0.16})`;
						ctx.lineWidth = 1;
						ctx.beginPath();
						ctx.moveTo(a.x, a.y);
						ctx.lineTo(b.x, b.y);
						ctx.stroke();
					}
				}
			}
		};

		const loop = () => {
			step();
			draw();
			raf = requestAnimationFrame(loop);
		};
		const start = () => {
			if (!raf && !reduce) raf = requestAnimationFrame(loop);
		};
		const stop = () => {
			if (raf) cancelAnimationFrame(raf);
			raf = 0;
		};

		window.addEventListener(
			"pointermove",
			(e) => {
				const r = canvas.getBoundingClientRect();
				const x = e.clientX - r.left;
				const y = e.clientY - r.top;
				if (x >= 0 && x <= r.width && y >= 0 && y <= r.height) {
					mouse.x = x;
					mouse.y = y;
				} else {
					mouse.x = -9999;
					mouse.y = -9999;
				}
			},
			{ passive: true },
		);

		readColors();
		resize();
		window.addEventListener("resize", resize);
		window.addEventListener("load", resize);
		new MutationObserver(readColors).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class"],
		});

		// Pause when the hero scrolls out of view or the tab is hidden
		if ("IntersectionObserver" in window) {
			new IntersectionObserver(
				(entries) => {
					entries.forEach((en) => (en.isIntersecting ? start() : stop()));
				},
				{ threshold: 0 },
			).observe(canvas);
		}
		document.addEventListener("visibilitychange", () => {
			document.hidden ? stop() : start();
		});

		if (reduce) draw();
		else start();
	}
</script>

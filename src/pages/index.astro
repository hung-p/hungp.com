---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Dock } from "../components/Dock";
import ProjectScene from "../components/ProjectScene.astro";
import ShowcaseRail from "../components/ShowcaseRail.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { tier1Projects } from "../data/projects";
import { ArrowRight, ArrowDown } from "lucide-react";

const featured = tier1Projects;

const steps = [
	{ n: "01", word: "Listen", desc: "Find a real problem worth solving." },
	{ n: "02", word: "Build", desc: "Make the smallest useful version." },
	{ n: "03", word: "Ship", desc: "Get it into people's hands." },
	{ n: "04", word: "Iterate", desc: "Learn from real use, then improve." },
];
---

<BaseLayout>
	<div class="space-y-24 md:space-y-36">
		<!-- Hero — full viewport width & height -->
		<section
			id="hero"
			class="relative -mt-8 ml-[calc(50%_-_50vw)] flex min-h-[100svh] w-screen flex-col md:-mt-14"
		>
			<!-- Brand "world" glow behind the headline -->
			<div
				class="pointer-events-none absolute left-[-12vw] top-1/2 z-0 h-[80vh] w-[75vw] -translate-y-1/2 bg-[radial-gradient(ellipse_46%_50%_at_50%_50%,hsl(var(--brand)/0.14),transparent_70%)]"
				aria-hidden="true"
			>
			</div>

			<!-- Interactive node-mesh (fills the hero) -->
			<canvas
				id="hero-net"
				class="pointer-events-none absolute inset-0 z-0 h-full w-full"
				aria-hidden="true"></canvas>

			<!-- Centered content -->
			<div
				class="relative z-10 mx-auto flex w-full max-w-[1120px] flex-1 items-center px-4 md:px-8"
			>
				<div class="max-w-3xl py-8">
					<p class="eyebrow reveal">AI Engineer · Builder</p>

					<div class="reveal mt-5">
						<span
							class="inline-flex items-center gap-2 rounded-full border border-live/25 bg-live/10 px-3.5 py-1.5 text-sm font-medium text-live"
						>
							<span class="relative flex h-2 w-2">
								<span
									class="absolute inline-flex h-full w-full animate-ping rounded-full bg-live opacity-75"
								></span>
								<span
									class="relative inline-flex h-2 w-2 rounded-full bg-live"
								></span>
							</span>
							Available for collaboration
						</span>
					</div>

					<p
						class="reveal mt-7 font-mono text-sm tracking-tight text-muted-foreground"
					>
						Hung Pham
					</p>

					<h1
						class="reveal mt-2 text-5xl font-semibold leading-[1.02] tracking-tighter md:text-7xl"
					>
						I build products that people
						<span
							class="bg-gradient-to-r from-brand to-brand-2 bg-clip-text text-transparent"
							>actually use</span
						>.
					</h1>

					<p
						class="reveal mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground md:text-xl"
					>
						A handful of personal projects, all in active development.<br/>
						Each built to solve a real problem and be genuinely useful,
						not just another demo.
					</p>

					<div class="reveal mt-9 flex flex-wrap gap-3">
						<a
							href="/projects"
							class="inline-flex items-center justify-center gap-2 rounded-full bg-brand px-6 py-3 font-medium text-brand-foreground shadow-lg shadow-brand/20 transition-all hover:-translate-y-0.5 hover:gap-3 hover:shadow-xl hover:shadow-brand/30"
						>
							See what I'm building
							<ArrowRight className="h-4 w-4" />
						</a>
						<a
							href="/about"
							class="inline-flex items-center justify-center gap-2 rounded-full border border-border bg-surface px-6 py-3 font-medium text-foreground transition-all hover:-translate-y-0.5 hover:border-foreground/15 hover:bg-surface-2"
						>
							About me
						</a>
					</div>
				</div>
			</div>

			<!-- How I build — one-word process, anchored to the bottom -->
			<div
				class="relative z-10 mx-auto w-full max-w-[1120px] px-4 pb-10 md:px-8"
			>
				<p class="eyebrow mb-4">How I build</p>
				<div
					id="how-steps"
					class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-border bg-border md:grid-cols-4"
				>
					{
						steps.map((s, i) => (
							<div
								data-step={i}
								class="group/step relative bg-background px-5 py-5 transition-colors hover:bg-surface data-[active]:bg-surface"
							>
								<span class="absolute inset-x-0 top-0 h-[2px] origin-left scale-x-0 bg-brand transition-transform duration-500 group-hover/step:scale-x-100 group-data-[active]/step:scale-x-100" />
								<div class="font-mono text-[12px] text-subtle transition-colors group-hover/step:text-brand-2 group-data-[active]/step:text-brand-2">
									{s.n}
								</div>
								<div class="mt-1.5 font-mono text-2xl font-semibold tracking-tight transition-colors group-hover/step:text-brand-2 group-data-[active]/step:text-brand-2 md:text-3xl">
									{s.word}
								</div>
								<p class="mt-2 h-8 text-[12.5px] leading-snug text-muted-foreground opacity-0 transition-opacity duration-500 group-hover/step:opacity-100 group-data-[active]/step:opacity-100">
									{s.desc}
								</p>
							</div>
						))
					}
				</div>
			</div>

			<!-- Scroll cue -->
			<button
				type="button"
				data-scroll-to="#work"
				aria-label="Scroll to projects"
				class="absolute bottom-1 left-1/2 z-10 hidden -translate-x-1/2 rounded-full p-2 text-subtle transition-colors hover:text-foreground md:block"
			>
				<ArrowDown className="h-4 w-4 animate-bounce" />
			</button>
		</section>

		<!-- What I'm building -->
		<section id="work" class="scroll-mt-24">
			<div class="reveal">
				<SectionHeader
					title="What I'm building"
					subtitle="A few personal projects in active development, built to be genuinely useful and getting better every week."
				/>
			</div>

			<ShowcaseRail projects={featured} />

			<div class="mt-4 md:mt-6">
				{featured.map((project, i) => <ProjectScene project={project} index={i} />)}
			</div>

			<div class="mt-10 text-center">
				<a
					href="/projects"
					class="inline-flex items-center gap-2 text-muted-foreground transition-colors hover:text-brand-2"
				>
					See all projects
					<ArrowRight className="h-4 w-4" />
				</a>
			</div>
		</section>
	</div>

	<Dock client:load />
</BaseLayout>

<script>
	// ─── Hero node-mesh — tweak these to taste ──────────────────────────────
	const CONFIG = {
		// Particles
		areaPerNode: 17000, // smaller = MORE particles (canvas px² per node)
		minNodes: 36,
		maxNodes: 110,
		driftSpeed: 0.65, // base roaming speed of particles (↑ = faster)
		nodeRadius: 1.5, // dot size at rest
		nodeRadiusNear: 2.3, // dot size when near the cursor
		linkDistance: 132, // max distance to draw a line between two particles
		linkOpacity: 0.16, // strength of the connecting lines

		// Cursor pull (only affects nearby particles)
		pullRadius: 190, // how close a particle must be to feel the pull
		pullStrength: 0.25, // how hard the cursor tugs (↓ = gentler)
		decay: 0.9, // how fast the pull/push fades back to free drift

		// Click shockwave
		clickRadius: 230, // how far the click pushes particles
		clickPush: 7, // strength of the outward shove
		sparks: 18, // number of sparkles per click
		sparkSpeed: 3.5, // how fast sparkles fly out
		sparkFade: 0.02, // how fast sparkles fade (↑ = shorter)
		glow: 14, // glow (blur) on the ring + sparks

		// Overheat → explosion (hold the cursor still and let particles gather)
		heatRadius: 5, // particles inside this inner ring heat up
		heatRise: 0.02, // how fast they heat while lingering (↑ = explodes sooner)
		heatFall: 0.018, // how fast they cool once they drift out
		explodeRadius: 350, // blast radius when a particle overheats
		explodePush: 22, // how hard the blast flings particles (↑ = farther)
		explodeSparks: 15, // sparks thrown by an explosion
		explodeSparkSpeed: 5.5, // how fast explosion sparks fly
	};
	// ────────────────────────────────────────────────────────────────────────

	const canvas = document.getElementById("hero-net") as HTMLCanvasElement | null;
	const ctx = canvas?.getContext("2d") ?? null;

	if (canvas && ctx) {
		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		let w = 0;
		let h = 0;
		// vx/vy = permanent free drift · px/py = decaying pull/push · heat = 0..1
		let nodes: {
			x: number;
			y: number;
			vx: number;
			vy: number;
			px: number;
			py: number;
			heat: number;
		}[] = [];
		let ripples: { x: number; y: number; r: number; a: number; c: string }[] = [];
		let sparks: {
			x: number;
			y: number;
			vx: number;
			vy: number;
			life: number;
			c: string;
		}[] = [];
		const mouse = { x: -9999, y: -9999 };
		let brand = "217 91% 60%";
		let fg = "0 0% 96%";
		const HOT = "8 90% 56%"; // red-orange for overheat explosions
		let raf = 0;

		const readColors = () => {
			const s = getComputedStyle(document.documentElement);
			brand = s.getPropertyValue("--brand").trim() || brand;
			fg = s.getPropertyValue("--foreground").trim() || fg;
		};

		const resize = () => {
			const r = canvas.getBoundingClientRect();
			w = r.width;
			h = r.height;
			canvas.width = Math.floor(w * dpr);
			canvas.height = Math.floor(h * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			const count = Math.min(
				CONFIG.maxNodes,
				Math.max(CONFIG.minNodes, Math.floor((w * h) / CONFIG.areaPerNode)),
			);
			nodes = [];
			for (let i = 0; i < count; i++) {
				nodes.push({
					x: Math.random() * w,
					y: Math.random() * h,
					vx: (Math.random() - 0.5) * CONFIG.driftSpeed,
					vy: (Math.random() - 0.5) * CONFIG.driftSpeed,
					px: 0,
					py: 0,
					heat: 0,
				});
			}
		};

		// Blast: fling nearby particles outward + red ring + red sparks
		const explode = (x: number, y: number) => {
			ripples.push({ x, y, r: 0, a: 0.85, c: HOT });
			for (let i = 0; i < CONFIG.explodeSparks; i++) {
				const ang =
					(Math.PI * 2 * i) / CONFIG.explodeSparks + Math.random() * 0.5;
				const spd = 3 + Math.random() * CONFIG.explodeSparkSpeed;
				sparks.push({
					x,
					y,
					vx: Math.cos(ang) * spd,
					vy: Math.sin(ang) * spd,
					life: 1,
					c: HOT,
				});
			}
			const ER = CONFIG.explodeRadius;
			for (const n of nodes) {
				const dx = n.x - x;
				const dy = n.y - y;
				const d2 = dx * dx + dy * dy;
				if (d2 < ER * ER) {
					const d = Math.sqrt(d2) || 1;
					const imp = (1 - d / ER) * CONFIG.explodePush;
					n.px += (dx / d) * imp;
					n.py += (dy / d) * imp;
					n.heat = 0; // reset so it can't instantly re-detonate
				}
			}
		};

		const step = () => {
			const active = mouse.x > -9000;
			const R = CONFIG.pullRadius;
			const HR = CONFIG.heatRadius;
			let blastX = -1;
			let blastY = -1;
			for (const n of nodes) {
				if (active) {
					const dx = mouse.x - n.x;
					const dy = mouse.y - n.y;
					const d2 = dx * dx + dy * dy;
					// gentle pull toward the cursor — only for nearby nodes
					if (d2 < R * R) {
						const d = Math.sqrt(d2) || 1;
						const f = (1 - d / R) * CONFIG.pullStrength;
						n.px += (dx / d) * f;
						n.py += (dy / d) * f;
					}
					// lingering in the small inner radius heats the particle up
					if (d2 < HR * HR) {
						n.heat += CONFIG.heatRise;
						if (n.heat >= 1) {
							n.heat = 0;
							blastX = mouse.x;
							blastY = mouse.y;
						}
					} else {
						n.heat -= CONFIG.heatFall;
					}
				} else {
					n.heat -= CONFIG.heatFall;
				}
				if (n.heat < 0) n.heat = 0;
				// move: constant free drift + decaying pull/push
				n.x += n.vx + n.px;
				n.y += n.vy + n.py;
				// bounce off edges so they keep roaming in-bounds
				if (n.x < 0) {
					n.x = 0;
					n.vx = Math.abs(n.vx);
					n.px *= -0.5;
				} else if (n.x > w) {
					n.x = w;
					n.vx = -Math.abs(n.vx);
					n.px *= -0.5;
				}
				if (n.y < 0) {
					n.y = 0;
					n.vy = Math.abs(n.vy);
					n.py *= -0.5;
				} else if (n.y > h) {
					n.y = h;
					n.vy = -Math.abs(n.vy);
					n.py *= -0.5;
				}
				// the pull/push fades, leaving the original drift
				n.px *= CONFIG.decay;
				n.py *= CONFIG.decay;
			}
			if (blastX >= 0) explode(blastX, blastY);
			// ripples expand & fade
			for (let i = ripples.length - 1; i >= 0; i--) {
				const rp = ripples[i];
				rp.r += (CONFIG.explodeRadius - rp.r) * 0.06 + 2;
				rp.a *= 0.93;
				if (rp.a < 0.02) ripples.splice(i, 1);
			}
			// sparks fly out & fade
			for (let i = sparks.length - 1; i >= 0; i--) {
				const s = sparks[i];
				s.x += s.vx;
				s.y += s.vy;
				s.vx *= 0.94;
				s.vy *= 0.94;
				s.life -= CONFIG.sparkFade;
				if (s.life <= 0) sparks.splice(i, 1);
			}
		};

		const draw = () => {
			const R = CONFIG.pullRadius;
			const LINK = CONFIG.linkDistance;
			ctx.clearRect(0, 0, w, h);
			for (let i = 0; i < nodes.length; i++) {
				const a = nodes[i];
				const dm = Math.hypot(a.x - mouse.x, a.y - mouse.y);
				const near = dm < R;
				if (near) {
					const o = (1 - dm / R) * 0.5;
					ctx.strokeStyle = `hsl(${brand} / ${o})`;
					ctx.lineWidth = 1;
					ctx.beginPath();
					ctx.moveTo(a.x, a.y);
					ctx.lineTo(mouse.x, mouse.y);
					ctx.stroke();
				}
				if (a.heat > 0.02) {
					// heating up: amber → red, growing and glowing
					const hue = 40 * (1 - a.heat);
					ctx.save();
					ctx.shadowBlur = 6 + a.heat * 16;
					ctx.shadowColor = `hsl(${hue} 95% 55%)`;
					ctx.fillStyle = `hsl(${hue} 95% ${60 - a.heat * 10}%)`;
					ctx.beginPath();
					ctx.arc(a.x, a.y, CONFIG.nodeRadius + 1.2 + a.heat * 3.5, 0, Math.PI * 2);
					ctx.fill();
					ctx.restore();
				} else {
					ctx.fillStyle = near ? `hsl(${brand} / 0.9)` : `hsl(${fg} / 0.22)`;
					ctx.beginPath();
					ctx.arc(
						a.x,
						a.y,
						near ? CONFIG.nodeRadiusNear : CONFIG.nodeRadius,
						0,
						Math.PI * 2,
					);
					ctx.fill();
				}
				for (let j = i + 1; j < nodes.length; j++) {
					const b = nodes[j];
					const d = Math.hypot(a.x - b.x, a.y - b.y);
					if (d < LINK) {
						ctx.strokeStyle = `hsl(${fg} / ${(1 - d / LINK) * CONFIG.linkOpacity})`;
						ctx.lineWidth = 1;
						ctx.beginPath();
						ctx.moveTo(a.x, a.y);
						ctx.lineTo(b.x, b.y);
						ctx.stroke();
					}
				}
			}
			// click / explosion visuals — glowing rings + sparks
			if (ripples.length || sparks.length) {
				ctx.save();
				ctx.shadowBlur = CONFIG.glow;
				for (const rp of ripples) {
					ctx.shadowColor = `hsl(${rp.c} / 0.9)`;
					ctx.strokeStyle = `hsl(${rp.c} / ${rp.a})`;
					ctx.lineWidth = 2;
					ctx.beginPath();
					ctx.arc(rp.x, rp.y, rp.r, 0, Math.PI * 2);
					ctx.stroke();
				}
				for (const s of sparks) {
					ctx.shadowColor = `hsl(${s.c} / 0.9)`;
					ctx.fillStyle = `hsl(${s.c} / ${Math.max(s.life, 0)})`;
					ctx.beginPath();
					ctx.arc(s.x, s.y, 1.9, 0, Math.PI * 2);
					ctx.fill();
				}
				ctx.restore();
			}
		};

		const loop = () => {
			step();
			draw();
			raf = requestAnimationFrame(loop);
		};
		const start = () => {
			if (!raf && !reduce) raf = requestAnimationFrame(loop);
		};
		const stop = () => {
			if (raf) cancelAnimationFrame(raf);
			raf = 0;
		};

		window.addEventListener(
			"pointermove",
			(e) => {
				const r = canvas.getBoundingClientRect();
				const x = e.clientX - r.left;
				const y = e.clientY - r.top;
				if (x >= 0 && x <= r.width && y >= 0 && y <= r.height) {
					mouse.x = x;
					mouse.y = y;
				} else {
					mouse.x = -9999;
					mouse.y = -9999;
				}
			},
			{ passive: true },
		);

		// Click → glowing shockwave: push nearby nodes out + ring + sparks
		window.addEventListener("pointerdown", (e) => {
			const r = canvas.getBoundingClientRect();
			const x = e.clientX - r.left;
			const y = e.clientY - r.top;
			if (x < 0 || x > r.width || y < 0 || y > r.height) return;
			ripples.push({ x, y, r: 0, a: 0.6, c: brand });
			for (let i = 0; i < CONFIG.sparks; i++) {
				const ang = (Math.PI * 2 * i) / CONFIG.sparks + Math.random() * 0.5;
				const spd = 2 + Math.random() * CONFIG.sparkSpeed;
				sparks.push({
					x,
					y,
					vx: Math.cos(ang) * spd,
					vy: Math.sin(ang) * spd,
					life: 1,
					c: brand,
				});
			}
			const CR = CONFIG.clickRadius;
			for (const n of nodes) {
				const dx = n.x - x;
				const dy = n.y - y;
				const d2 = dx * dx + dy * dy;
				if (d2 < CR * CR) {
					const d = Math.sqrt(d2) || 1;
					const imp = (1 - d / CR) * CONFIG.clickPush;
					n.px += (dx / d) * imp;
					n.py += (dy / d) * imp;
				}
			}
			if (!reduce) start();
		});

		readColors();
		resize();
		window.addEventListener("resize", resize);
		window.addEventListener("load", resize);
		new MutationObserver(readColors).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class"],
		});

		// Pause when the hero scrolls out of view or the tab is hidden
		if ("IntersectionObserver" in window) {
			new IntersectionObserver(
				(entries) => {
					entries.forEach((en) => (en.isIntersecting ? start() : stop()));
				},
				{ threshold: 0 },
			).observe(canvas);
		}
		document.addEventListener("visibilitychange", () => {
			document.hidden ? stop() : start();
		});

		if (reduce) draw();
		else start();
	}
</script>

<script>
	// "How I build" — auto-cycle the active step; pause and follow on hover.
	(function () {
		const boxes = Array.from(
			document.querySelectorAll<HTMLElement>("[data-step]"),
		);
		if (!boxes.length) return;
		let i = 0;
		let paused = false;
		const setActive = (n: number) => {
			boxes.forEach((b, k) =>
				k === n
					? b.setAttribute("data-active", "")
					: b.removeAttribute("data-active"),
			);
			i = n;
		};
		boxes.forEach((b, k) => {
			b.addEventListener("pointerenter", () => {
				paused = true;
				setActive(k);
			});
			b.addEventListener("pointerleave", () => {
				paused = false;
			});
		});
		setActive(0);
		if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			window.setInterval(() => {
				if (!paused) setActive((i + 1) % boxes.length);
			}, 2400);
		}
	})();
</script>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Dock } from "../components/Dock";
import { siteConfig } from "../site.config";
import { techStack } from "../data/projects";
import {
  Mail,
  Github,
  Linkedin,
  Twitter,
  Hammer,
  Layers,
  RefreshCw,
  Globe,
  Sparkles,
} from "lucide-react";

const stackGroups = [
  { key: "frontend", label: "Frontend", dot: "bg-sky-400", items: techStack.frontend },
  { key: "backend", label: "Backend", dot: "bg-live", items: techStack.backend },
  { key: "ai_ml", label: "AI / ML", dot: "bg-brand", items: techStack.ai_ml },
  { key: "tools", label: "Tools", dot: "bg-amber-400", items: techStack.tools },
];
---

<BaseLayout
  title="About Hung Pham | Engineer & Builder"
  description="Hung Pham builds useful products that people actually use. A few personal projects in active development."
>
  <div class="space-y-16 md:space-y-24">
    <!-- Intro -->
    <section class="pt-12 md:pt-16">
      <div class="grid gap-12 lg:grid-cols-3">
        <div class="space-y-7 lg:col-span-2">
          <div class="reveal">
            <p class="eyebrow mb-5">About</p>
            <h1
              class="text-4xl font-semibold leading-[1.1] tracking-tighter md:text-6xl"
            >
              On building useful things.
            </h1>
          </div>

          <div class="reveal space-y-5">
            <p class="text-base leading-relaxed text-muted-foreground md:text-[17px]">
              I build products, and what I care about most is whether people
              <span class="font-medium text-foreground">actually use them</span>.
              Not demos, not slides that look good in a pitch. Things that earn a
              place in someone's day.
            </p>
            <p class="text-base leading-relaxed text-muted-foreground md:text-[17px]">
              Right now that's a <span class="font-medium text-brand-2"
                >handful of personal projects</span
              >, all in active development. Some are live and growing; others are
              early experiments still finding their shape, but each one is aimed
              at a real problem worth solving.
            </p>
            <p class="text-base leading-relaxed text-muted-foreground md:text-[17px]">
              I'm an engineer by training, and <span
                class="font-medium text-foreground">AI is one of the tools</span
              > I reach for, but it's never the point. The point is the product:
              useful, well-made, and worth coming back to. I care about shipping,
              listening, and making the next version better.
            </p>
          </div>
        </div>

        <!-- Side cards -->
        <div class="space-y-5">
          <div class="reveal rounded-2xl border border-border bg-surface p-6">
            <h2 class="mb-4 flex items-center justify-between text-lg font-semibold">
              At a glance
              <span class="font-mono text-[11px] text-subtle">/ how I work</span>
            </h2>
            <div class="space-y-3.5">
              <div class="flex items-center gap-3 text-muted-foreground">
                <Hammer className="h-4 w-4 flex-none text-subtle" />
                <span>Builds useful products</span>
              </div>
              <div class="flex items-center gap-3 text-muted-foreground">
                <Layers className="h-4 w-4 flex-none text-subtle" />
                <span>A few personal projects, in development</span>
              </div>
              <div class="flex items-center gap-3 text-muted-foreground">
                <RefreshCw className="h-4 w-4 flex-none text-subtle" />
                <span>Ships, listens, iterates</span>
              </div>
              <div class="flex items-center gap-3 text-muted-foreground">
                <Globe className="h-4 w-4 flex-none text-subtle" />
                <span>Based in {siteConfig.location}</span>
              </div>
            </div>
          </div>

          <div class="reveal rounded-2xl border border-border bg-surface p-6">
            <h2 class="mb-4 flex items-center justify-between text-lg font-semibold">
              Connect
              <span class="font-mono text-[11px] text-subtle">/ say hi</span>
            </h2>
            <div class="space-y-1">
              <a
                href={siteConfig.github}
                target="_blank"
                rel="noopener noreferrer"
                class="-mx-2 flex items-center gap-3 rounded-lg px-2 py-2 text-muted-foreground transition-colors hover:bg-surface-2 hover:text-foreground"
              >
                <Github className="h-4 w-4" />
                <span>GitHub</span>
              </a>
              <a
                href={siteConfig.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="-mx-2 flex items-center gap-3 rounded-lg px-2 py-2 text-muted-foreground transition-colors hover:bg-surface-2 hover:text-foreground"
              >
                <Linkedin className="h-4 w-4" />
                <span>LinkedIn</span>
              </a>
              <a
                href={siteConfig.twitter}
                target="_blank"
                rel="noopener noreferrer"
                class="-mx-2 flex items-center gap-3 rounded-lg px-2 py-2 text-muted-foreground transition-colors hover:bg-surface-2 hover:text-foreground"
              >
                <Twitter className="h-4 w-4" />
                <span>Twitter / X</span>
              </a>
              <button
                type="button"
                data-copy={siteConfig.email}
                aria-label={`Copy email ${siteConfig.email}`}
                class="-mx-2 flex w-full items-center gap-3 rounded-lg px-2 py-2 text-left text-muted-foreground transition-colors hover:bg-surface-2 hover:text-foreground data-[copied]:text-live"
              >
                <Mail className="h-4 w-4" />
                <span data-copy-label>{siteConfig.email}</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section>
      <h2 class="reveal mb-8 text-2xl font-semibold tracking-tight md:text-3xl">
        Skills &amp; Stack
      </h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          stackGroups.map((group) => (
            <div class="reveal rounded-2xl border border-border bg-surface p-5">
              <h3 class="mb-4 font-mono text-[11px] uppercase tracking-[0.14em] text-subtle">
                {group.label}
              </h3>
              <div class="space-y-2">
                {group.items.map((tech) => (
                  <div class="flex items-center gap-2.5 text-sm">
                    <span class={`h-1.5 w-1.5 flex-none rounded-full ${group.dot}`} />
                    <span>{tech}</span>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- CTA -->
    <section
      class="reveal relative overflow-hidden rounded-3xl border border-border p-8 md:p-12"
    >
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_70%_100%_at_100%_0%,hsl(var(--brand)/0.16),transparent_60%)]"
        aria-hidden="true"
      >
      </div>

      <div class="max-w-2xl">
        <span
          class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand/25 bg-brand/10 px-3 py-1.5 text-sm font-medium text-brand-2"
        >
          <Sparkles className="h-4 w-4" />
          Open to collaboration
        </span>

        <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">
          Let's build something useful.
        </h2>

        <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
          I'm always glad to meet other builders and curious people. Whether you
          want to collaborate on something, try one of the projects, or just
          trade notes, I'd love to hear from you.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <button
            type="button"
            data-copy={siteConfig.email}
            aria-label={`Copy email ${siteConfig.email}`}
            class="inline-flex items-center justify-center gap-2 rounded-full bg-brand px-6 py-3 font-medium text-brand-foreground shadow-lg shadow-brand/20 transition-all hover:-translate-y-0.5 hover:gap-3 hover:shadow-xl hover:shadow-brand/30"
          >
            <Mail className="h-4 w-4" />
            <span data-copy-label>{siteConfig.email}</span>
          </button>
          <a
            href="/projects"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-border bg-surface px-6 py-3 font-medium text-foreground transition-all hover:-translate-y-0.5 hover:border-foreground/15 hover:bg-surface-2"
          >
            See the projects
          </a>
        </div>

        <div class="mt-8 border-t border-border pt-8 text-sm text-muted-foreground">
          <p class="mb-2 font-medium text-foreground">What I'm looking for:</p>
          <ul class="space-y-1">
            <li>• People to build useful products with</li>
            <li>• Early users and honest feedback</li>
            <li>• Collaborators who care about craft</li>
            <li>• Anyone working on something genuinely useful</li>
          </ul>
        </div>
      </div>
    </section>
  </div>

  <Dock client:load />
</BaseLayout>

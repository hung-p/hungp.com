---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Dock } from "../../components/Dock";
import { allProjects, getProjectBySlug, type Project } from "../../data/projects";
import {
	ArrowLeft,
	ArrowUpRight,
	Calendar,
	Tag,
	Activity,
	ExternalLink,
} from "lucide-react";

export function getStaticPaths() {
	return allProjects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

interface Props {
	project: Project;
}

const { project } = Astro.props;

const statusColors = {
	active: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
	beta: "bg-amber-500/10 text-amber-400 border-amber-500/20",
	development: "bg-blue-500/10 text-blue-400 border-blue-500/20",
	concept: "bg-purple-500/10 text-purple-400 border-purple-500/20",
};

const statusLabels = {
	active: "Active",
	beta: "Beta",
	development: "In Development",
	concept: "Concept",
};
---

<BaseLayout
	title={`${project.title} | Hung Pham`}
	description={project.description}
>
	<div class="pb-32">
		<!-- Back Link -->
		<div class="pt-8 mb-8">
			<a
				href="/studio"
				class="inline-flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors"
			>
				<ArrowLeft className="w-4 h-4" />
				Back to Studio
			</a>
		</div>

		<!-- Hero Section -->
		<section class="mb-16">
			<div class="max-w-4xl">
				<!-- Status & Year -->
				<div class="flex items-center gap-3 mb-6">
					{project.status && (
						<span
							class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-medium border ${statusColors[project.status]}`}
						>
							<Activity className="w-3.5 h-3.5" />
							{statusLabels[project.status]}
						</span>
					)}
					{project.year && (
						<span class="inline-flex items-center gap-1.5 text-muted-foreground text-sm">
							<Calendar className="w-3.5 h-3.5" />
							{project.year}
						</span>
					)}
				</div>

				<!-- Title -->
				<h1
					class="text-4xl md:text-6xl font-bold tracking-tighter mb-6 bg-clip-text text-transparent bg-gradient-to-b from-foreground to-foreground/60"
				>
					{project.title}
				</h1>

				<!-- Stats Badge -->
				{project.stats && (
					<div class="mb-6">
						<span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 text-emerald-400 text-lg font-medium border border-emerald-500/20">
							{project.stats}
						</span>
					</div>
				)}

				<!-- Tags -->
				<div class="flex flex-wrap gap-2 mb-8">
					{project.tags.map((tag) => (
						<span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/5 text-muted-foreground text-sm border border-white/10">
							<Tag className="w-3 h-3" />
							{tag}
						</span>
					))}
				</div>

				<!-- CTA -->
				{project.href && project.href !== "#" && (
					<a
						href={project.href}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-primary text-primary-foreground font-medium hover:opacity-90 transition-all hover:gap-3"
					>
						<ExternalLink className="w-4 h-4" />
						Visit {project.title}
						<ArrowUpRight className="w-4 h-4" />
					</a>
				)}
			</div>
		</section>

		<!-- Content Section -->
		<section class="max-w-4xl">
			<div class="prose prose-invert prose-lg max-w-none">
				{(project.longDescription || project.description).split('\n\n').map((paragraph) => (
					<p class="text-muted-foreground leading-relaxed mb-6">
						{paragraph}
					</p>
				))}
			</div>
		</section>

		<!-- Related Projects -->
		<section class="mt-24">
			<h2 class="text-2xl font-bold mb-8">Other Projects</h2>
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
				{allProjects
					.filter((p) => p.slug !== project.slug)
					.slice(0, 3)
					.map((p) => (
						<a
							href={`/projects/${p.slug}`}
							class="group p-6 rounded-2xl border border-white/10 bg-card/30 hover:border-primary/30 transition-all hover:-translate-y-1"
						>
							<h3 class="text-lg font-semibold mb-2 group-hover:text-primary transition-colors">
								{p.title}
							</h3>
							<p class="text-sm text-muted-foreground line-clamp-2">
								{p.description}
							</p>
							<div class="flex flex-wrap gap-1.5 mt-4">
								{p.tags.slice(0, 2).map((tag) => (
									<span class="text-xs px-2 py-0.5 rounded-full bg-white/5 text-muted-foreground">
										{tag}
									</span>
								))}
							</div>
						</a>
					))}
			</div>
		</section>
	</div>

	<Dock client:load />
</BaseLayout>

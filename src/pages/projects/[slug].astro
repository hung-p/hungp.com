---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Dock } from "../../components/Dock";
import { allProjects, type Project } from "../../data/projects";
import {
	ArrowLeft,
	ArrowUpRight,
	Calendar,
	Tag,
	Activity,
	ExternalLink,
} from "lucide-react";

export function getStaticPaths() {
	return allProjects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

interface Props {
	project: Project;
}

const { project } = Astro.props;

const statusColors = {
	active: "bg-live/10 text-live border-live/25",
	beta: "bg-amber-500/10 text-amber-500 border-amber-500/25",
	development: "bg-sky-500/10 text-sky-400 border-sky-500/25",
	concept: "bg-brand/10 text-brand-2 border-brand/25",
};

const statusLabels = {
	active: "Active",
	beta: "Beta",
	development: "In Development",
	concept: "Concept",
};

const related = allProjects.filter((p) => p.slug !== project.slug).slice(0, 3);
---

<BaseLayout title={`${project.title} | Hung Pham`} description={project.description}>
	<div>
		<!-- Back -->
		<div class="pt-6 md:pt-8">
			<a
				href="/projects"
				class="inline-flex items-center gap-2 text-muted-foreground transition-colors hover:text-foreground"
			>
				<ArrowLeft className="h-4 w-4" />
				Back to projects
			</a>
		</div>

		<!-- Hero -->
		<section class="mt-8 md:mt-10">
			<div class="reveal max-w-3xl">
				<div class="mb-6 flex flex-wrap items-center gap-3">
					{
						project.status && (
							<span
								class={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-sm font-medium ${statusColors[project.status]}`}
							>
								<Activity className="h-3.5 w-3.5" />
								{statusLabels[project.status]}
							</span>
						)
					}
					{
						project.year && (
							<span class="inline-flex items-center gap-1.5 text-sm text-subtle">
								<Calendar className="h-3.5 w-3.5" />
								{project.year}
							</span>
						)
					}
				</div>

				<h1
					class="bg-gradient-to-b from-foreground to-foreground/60 bg-clip-text text-4xl font-bold tracking-tighter text-transparent md:text-6xl"
				>
					{project.title}
				</h1>

				{
					project.stats && (
						<div class="mt-6">
							<span class="inline-flex items-center gap-2 rounded-full border border-live/25 bg-live/10 px-4 py-2 text-lg font-medium text-live">
								{project.stats}
							</span>
						</div>
					)
				}

				<div class="mt-6 flex flex-wrap gap-2">
					{
						project.tags.map((tag) => (
							<span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1.5 font-mono text-[12px] text-muted-foreground">
								<Tag className="h-3 w-3" />
								{tag}
							</span>
						))
					}
				</div>

				{
					project.href && project.href !== "#" && (
						<a
							href={project.href}
							target="_blank"
							rel="noopener noreferrer"
							class="mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-brand px-6 py-3 font-medium text-brand-foreground shadow-lg shadow-brand/20 transition-all hover:-translate-y-0.5 hover:gap-3 hover:shadow-xl hover:shadow-brand/30"
						>
							<ExternalLink className="h-4 w-4" />
							Visit {project.title}
							<ArrowUpRight className="h-4 w-4" />
						</a>
					)
				}
			</div>
		</section>

		<!-- Screenshot -->
		<section class="reveal mt-12 max-w-4xl">
			<div
				class="relative aspect-video overflow-hidden rounded-2xl border border-border bg-surface"
			>
				{
					project.image ? (
						<img
							src={project.image}
							alt={`${project.title} screenshot`}
							loading="lazy"
							decoding="async"
							class="absolute inset-0 h-full w-full object-cover"
						/>
					) : (
						<div class="absolute inset-0 grid place-items-center bg-gradient-to-br from-brand/20 via-surface to-surface-2">
							<span class="font-mono text-7xl font-bold text-foreground/10">
								{project.title.trim().charAt(0).toUpperCase()}
							</span>
						</div>
					)
				}
			</div>
		</section>

		<!-- Body -->
		<section class="reveal mt-14 max-w-3xl">
			{
				(project.longDescription || project.description)
					.split("\n\n")
					.map((paragraph) => (
						<p class="mb-6 text-[17px] leading-relaxed text-muted-foreground [&_strong]:font-semibold [&_strong]:text-foreground" set:html={paragraph.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")} />
					))
			}
		</section>

		<!-- Related -->
		<section class="mt-24">
			<h2 class="reveal mb-8 text-2xl font-semibold tracking-tight">
				Other Projects
			</h2>
			<div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
				{
					related.map((p) => (
						<a
							href={`/projects/${p.slug}`}
							class="reveal group rounded-2xl border border-border bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-foreground/15 hover:bg-surface-2"
						>
							<h3 class="mb-2 text-lg font-semibold tracking-tight transition-colors group-hover:text-brand-2">
								{p.title}
							</h3>
							<p class="line-clamp-2 text-sm leading-relaxed text-muted-foreground">
								{p.description}
							</p>
							<div class="mt-4 flex flex-wrap gap-1.5">
								{p.tags.slice(0, 2).map((tag) => (
									<span class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-[10.5px] text-subtle">
										{tag}
									</span>
								))}
							</div>
						</a>
					))
				}
			</div>
		</section>
	</div>

	<Dock client:load />
</BaseLayout>

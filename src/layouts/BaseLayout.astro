---
import BaseHead from "../components/BaseHead.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { siteConfig } from "../site.config";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    type?: "website" | "article";
    publishedTime?: Date;
    noindex?: boolean;
}

const {
    title = `${siteConfig.title} | AI Engineer & Builder`,
    description = siteConfig.description,
    image = "/og-image.png",
    type = "website",
    publishedTime,
    noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang={siteConfig.lang} class="dark">
    <head>
        <BaseHead
            title={title}
            description={description}
            image={image}
            type={type}
            publishedTime={publishedTime}
            noindex={noindex}
        />
        <!-- No-FOUC theme init: applies saved theme before first paint -->
        <script is:inline>
            (function () {
                var el = document.documentElement;
                el.classList.add("js");
                try {
                    if (localStorage.getItem("theme") === "light")
                        el.classList.remove("dark");
                    else el.classList.add("dark");
                } catch (e) {
                    el.classList.add("dark");
                }
            })();
        </script>
    </head>
    <body
        class="min-h-screen overflow-x-clip bg-background font-sans text-foreground antialiased"
    >
        <!-- Skip to content (keyboard users) -->
        <a
            href="#main"
            class="sr-only z-[80] rounded-lg bg-brand px-4 py-2 font-medium text-brand-foreground focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
        >
            Skip to content
        </a>

        <!-- Ambient background -->
        <div class="bg-grid" aria-hidden="true"></div>
        <div class="bg-glow" aria-hidden="true"></div>
        <div class="bg-grain" aria-hidden="true"></div>

        <ThemeToggle />

        <main class="relative flex min-h-screen flex-col">
            <div
                id="main"
                tabindex="-1"
                class="w-full flex-1 mx-auto max-w-[1120px] px-4 py-8 outline-none md:px-8 md:py-14"
            >
                <slot />
            </div>
            <SiteFooter />
        </main>

        <!-- Micro-interactions: scroll reveal + stat count-up -->
        <script is:inline>
            (function () {
                var reduce = window.matchMedia(
                    "(prefers-reduced-motion: reduce)",
                ).matches;
                var hasIO = "IntersectionObserver" in window;
                var reveals = document.querySelectorAll(".reveal");

                if (reduce || !hasIO) {
                    reveals.forEach(function (el) {
                        el.classList.add("in");
                    });
                } else {
                    var io = new IntersectionObserver(
                        function (entries) {
                            entries.forEach(function (en) {
                                if (en.isIntersecting) {
                                    en.target.classList.add("in");
                                    io.unobserve(en.target);
                                }
                            });
                        },
                        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
                    );
                    reveals.forEach(function (el) {
                        io.observe(el);
                    });
                }

                function countUp(el) {
                    var target = parseFloat(el.getAttribute("data-countup")) || 0;
                    var suffix = el.getAttribute("data-suffix") || "";
                    var dur = 1100,
                        start = null;
                    function step(ts) {
                        if (!start) start = ts;
                        var p = Math.min((ts - start) / dur, 1);
                        var e = 1 - Math.pow(1 - p, 3);
                        el.textContent = Math.round(target * e) + suffix;
                        if (p < 1) requestAnimationFrame(step);
                    }
                    requestAnimationFrame(step);
                }
                var nums = document.querySelectorAll("[data-countup]");
                if (nums.length) {
                    if (reduce || !hasIO) {
                        nums.forEach(function (el) {
                            el.textContent =
                                el.getAttribute("data-countup") +
                                (el.getAttribute("data-suffix") || "");
                        });
                    } else {
                        var nio = new IntersectionObserver(
                            function (entries) {
                                entries.forEach(function (en) {
                                    if (en.isIntersecting) {
                                        countUp(en.target);
                                        nio.unobserve(en.target);
                                    }
                                });
                            },
                            { threshold: 0.6 },
                        );
                        nums.forEach(function (el) {
                            nio.observe(el);
                        });
                    }
                }
            })();
        </script>

        <!-- Click-to-copy (e.g. email) + back-to-top, via event delegation -->
        <script is:inline>
            (function () {
                function flash(el) {
                    var label = el.querySelector("[data-copy-label]");
                    el.setAttribute("data-copied", "");
                    if (label) {
                        if (label.dataset.original == null)
                            label.dataset.original = label.textContent;
                        label.textContent = "Copied!";
                    }
                    window.clearTimeout(el.__copyT);
                    el.__copyT = window.setTimeout(function () {
                        el.removeAttribute("data-copied");
                        if (label && label.dataset.original != null)
                            label.textContent = label.dataset.original;
                    }, 1600);
                }
                document.addEventListener("click", function (e) {
                    var t = e.target;
                    var copyEl = t.closest ? t.closest("[data-copy]") : null;
                    if (copyEl) {
                        e.preventDefault();
                        var val = copyEl.getAttribute("data-copy");
                        if (navigator.clipboard && navigator.clipboard.writeText) {
                            navigator.clipboard.writeText(val).then(
                                function () { flash(copyEl); },
                                function () { flash(copyEl); },
                            );
                        } else {
                            var ta = document.createElement("textarea");
                            ta.value = val;
                            ta.setAttribute("readonly", "");
                            ta.style.position = "absolute";
                            ta.style.left = "-9999px";
                            document.body.appendChild(ta);
                            ta.select();
                            try { document.execCommand("copy"); } catch (_) {}
                            document.body.removeChild(ta);
                            flash(copyEl);
                        }
                        return;
                    }
                    var topEl = t.closest ? t.closest("[data-scroll-top]") : null;
                    if (topEl) {
                        e.preventDefault();
                        window.scrollTo({ top: 0, behavior: "smooth" });
                        return;
                    }
                    var goEl = t.closest ? t.closest("[data-scroll-to]") : null;
                    if (goEl) {
                        e.preventDefault();
                        var target = document.querySelector(
                            goEl.getAttribute("data-scroll-to"),
                        );
                        if (target)
                            target.scrollIntoView({
                                behavior: "smooth",
                                block: "start",
                            });
                    }
                });
            })();
        </script>
    </body>
</html>
